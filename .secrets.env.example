# AI Coding Base Setup - Required API Keys
# Copy to ~/.aicodingsetup/.secrets.env or run install.sh to be prompted

FIRECRAWL_API_KEY=
BRAVE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# gh CLI auth. No longer exported into shells (configs/bash/env.sh unsets
# GH_TOKEN/GITHUB_TOKEN); git reads it through git-credential-aicoding and gh
# through its stored login, both from this file.
# Must be listed here or install.sh's secrets rewrite would drop it.
GH_TOKEN=

# Bearer token for the central memory-lanes retrieval router MCP on vossisrv
# (http://10.0.0.249:8091/mcp). Unset = the memory-router MCP is not registered.
MEMORY_ROUTER_TOKEN=

# Write token for https://logfire.pydantic.dev, read by the logfire MCP server.
LOGFIRE_TOKEN=

# Bearer token for the estate backlog board https://kanban.dataprospectors.at,
# read by bin/kanban-post. Unset = agents cannot file tickets.
KANBAN_TOKEN=
