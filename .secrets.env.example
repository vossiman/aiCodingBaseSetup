# AI Coding Base Setup - Required API Keys
# Copy to ~/.aicodingsetup/.secrets.env or run install.sh to be prompted

FIRECRAWL_API_KEY=
BRAVE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# gh CLI auth. Exported into every shell by configs/bash/env.sh; GH_TOKEN
# outranks the keyring and ~/.config/gh, so gh is authed with no gh mount.
# Must be listed here or install.sh's secrets rewrite would drop it.
GH_TOKEN=

# Bearer token for the central memory-lanes retrieval router MCP on vossisrv
# (http://10.0.0.249:8091/mcp). Unset = the memory-router MCP is not registered.
MEMORY_ROUTER_TOKEN=

# OpenRouter key funding the memory-lanes extraction lanes' LLM spend.
OPENROUTER_API_KEY=
