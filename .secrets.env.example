# AI Coding Base Setup - keys a fresh machine is asked for
# Copy to ~/.aicodingsetup/.secrets.env or run install.sh to be prompted.
# An install only appends keys missing from an existing store; it never
# removes keys this file does not list.
# Values are raw (no quotes, no spaces): sync sources the store as shell.

FIRECRAWL_API_KEY=
BRAVE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# gh CLI auth. No longer exported into shells (configs/bash/env.sh unsets
# GH_TOKEN/GITHUB_TOKEN); git reads it through git-credential-aicoding and gh
# through its stored login, both from this file.
GH_TOKEN=

# Write token for the memory-lanes router on vossisrv (client "devbox" in the
# router's MEMORY_WRITE_TOKENS). It also authorizes search, so every
# harness's memory-router MCP and the /hint auto-hint path use it. Unset =
# no memory-router MCP and no auto-hints.
MEMORY_WRITE_TOKEN=

# Bearer token for the estate backlog board https://kanban.dataprospectors.at,
# read by bin/kanban-work and rendered into each harness's kanban MCP entry.
# Unset = no kanban MCP and agents cannot file tickets.
KANBAN_TOKEN=

# Bearer token for the estate Bugsink API (https://bugsink.dataprospectors.at),
# read by bin/bugsink-api. Unset = bugsink-api reports "not set".
BUGSINK_AUTH_TOKEN=

# Logfire read token, used outside this repo (Logfire queries). Nothing in
# aiCodingBaseSetup reads it; listed so a fresh machine is asked for it.
LOGFIRE_READ_API_TOKEN=

# Admin tokens for lean-iptv's diagnostics read route, one per environment,
# read by bin/leaniptv-diag. They match DIAGNOSTICS_READ_TOKEN in the Dokploy
# env of lean-iptv-prod and lean-iptv-staging. Unset = that environment
# reports "not configured".
LEANIPTV_DIAG_TOKEN_PROD=
LEANIPTV_DIAG_TOKEN_STAGING=
