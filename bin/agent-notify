#!/usr/bin/env bash
# agent-notify — flag the current tmux window as waiting-for-input. Called by
# Claude Code's Notification hook, codex's notify hook, and tmux alert hooks.
# Contract: NEVER exits non-zero, never blocks the caller on failure paths;
# errors go to ~/.cache/aicoding/agent-notify.log. Spec: devMachine
# docs/superpowers/specs/2026-08-09-agent-waiting-phone-notify-design.md
#
# The ntfy phone-push half was retired 2026-08-10 (informational only — no
# Android action could open an SSH session into the right window) and its code
# deleted 2026-08-20. Flagging + `dvw attach` are the whole feature now, so
# this touches no network and reads no secrets. Kill switch:
# AGENT_NOTIFY_DISABLE=1 in the environment.
set -u

LOG_DIR="$HOME/.cache/aicoding"
LOG="$LOG_DIR/agent-notify.log"
mkdir -p "$LOG_DIR" 2>/dev/null || true
log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG" 2>/dev/null || true; }

[ "${AGENT_NOTIFY_DISABLE:-}" = "1" ] && exit 0

# --priority/--title/--body and codex's positional JSON described the push
# payload. They are still accepted and ignored so deployed callers keep working
# unchanged; only --source (logging) and --window are load-bearing.
source_kind="unknown" window=""
while [ $# -gt 0 ]; do
  case "$1" in
    --source)   source_kind="${2:-unknown}"; shift 2 ;;
    --window)   window="${2:-}"; shift 2 ;;
    --priority|--title|--body) shift 2 ;;
    *)          shift ;;
  esac
done

if [ -z "${TMUX:-}" ] && [ -z "$window" ]; then exit 0; fi
command -v tmux >/dev/null 2>&1 || exit 0

if [ -z "$window" ] && [ -n "${TMUX_PANE:-}" ]; then
  window="$(tmux display -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null)"
fi
if ! [[ "$window" =~ ^@[0-9]+$ ]]; then
  log "bad or missing window id '$window' (source=$source_kind)"
  exit 0
fi

# Focused-window gate: the active window of an attached session is the one the
# user is already looking at — same policy as tmux.conf's bell/activity/silence
# "other" actions, which agent CLI hooks (claude Notification, codex notify)
# otherwise bypass. Flagging it would stick (no clear hook fires without a
# window *change*, so a single-window session shows "⏸ waiting" forever).
# Clear any stale flag while here: agent activity in a watched window proves
# the user is present.
focus="$(tmux display -p -t "$window" '#{window_active} #{session_attached}' 2>/dev/null || true)"
case "$focus" in
  "1 "[1-9]*)
    tmux set-option -w -u -t "$window" @waiting 2>/dev/null || true
    exit 0 ;;
esac

# Preserve the original episode timestamp: dvw's catalog surfaces @waiting as
# `waiting_since` and sorts on it, so a later hook in the same waiting-episode
# must not push the epoch forward.
existing="$(tmux show-options -w -v -t "$window" @waiting 2>/dev/null || true)"
[ -n "$existing" ] && exit 0

tmux set-option -w -t "$window" @waiting "$(date +%s)" 2>/dev/null || true
exit 0
