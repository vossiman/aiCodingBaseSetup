#!/usr/bin/env bash
# redact-sessions: scrub secrets-file values out of agent transcripts on
# disk and report each hit so the credential gets rotated.
# Spec: docs/superpowers/specs/2026-09-07-redact-sessions-design.md
#
#   redact-sessions --sweep        every quiet transcript under the known roots
#   redact-sessions --now FILE...  exactly these files, ignoring the quiet period
#   redact-sessions --ack KEY      clear KEY from the pending-rotation marker
#
# Literal layer only (lib/redact-literal.sh, sessions mode): raw, JSON-escaped
# and base64-aligned forms of every secrets-file value, replaced with
# [REDACTED:KEYNAME]. The pattern and entropy layers of redact-transcript are
# deliberately not used here; they would eat digests and ids a resumed
# session needs, and their hits carry no key name to rotate.
#
# SQLite stores (cursor store.db, opencode.db) go through lib/redact-sqlite.py:
# one transaction, secure_delete, WAL checkpointed. Spec:
# docs/superpowers/specs/2026-09-07-redact-sessions-sqlite-design.md
#
# Live files: no harness holds its transcript open (Claude Code appends by
# path) and the roots are host mounts shared across containers with separate
# PID namespaces, so there is no open-file test. Safety is a quiet period on
# sweeps plus check-and-swap: the rename lands only if the file is still
# byte-for-byte what was read.
#
# State (shared ~/.claude mount, visible from every container):
#   log       one line per hit, never a value
#   pending   key names awaiting --ack, or SECRETS_FILE_UNREADABLE
#   deferred  files skipped this sweep (quiet period, swap refused twice)
#   stamp     mtime watermark for --sweep
#   rules.fp.<host>  salted digest of the rule set and roots the stamp was taken under
#
# Exit: 0 ok, 2 usage, 3 secrets file unreadable or partially parsed (nothing
# touched). Never prints a secret value. The secrets file is only ever READ.
set -uo pipefail

_rs_self="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=../lib/redact-literal.sh
. "$(dirname "$_rs_self")/../lib/redact-literal.sh"

STATE="${REDACT_SESSIONS_STATE:-$HOME/.claude/state/redact-sessions}"
PY="${REDACT_SESSIONS_PYTHON:-python3}"
HELPER="$(dirname "$_rs_self")/../lib/redact-sqlite.py"
QUIET="${REDACT_QUIET_SECONDS:-120}"
SECRETS="${AICODING_SECRETS_FILE:-$HOME/.aicodingsetup/.secrets.env}"
HOST="$(hostname 2>/dev/null || echo unknown)"
RULES=""
PAIRS=""

# Roots, one per harness: root|glob|write-mode.
#   rename   write a temp file and rename it over the original. Right for a
#            writer that appends by path (Claude Code and cursor-agent:
#            lsof shows no open handle on a live transcript, measured
#            2026-09-07).
#   inplace  truncate and rewrite the same inode. Right for a writer that
#            keeps the file open with O_APPEND (codex: fd flags 02102002 on
#            its rollout file for the whole run, measured 2026-09-07). A
#            rename would strand its later writes on the unlinked inode; an
#            O_APPEND writer lands its next record after the rewritten
#            content instead.
#   sqlite   hand the file to lib/redact-sqlite.py, which rewrites the store
#            in one transaction and checkpoints its WAL. Cursor's store.db
#            (content-addressed blobs) and OpenCode's opencode.db.
# A root may also be a single file (empty glob): the prompt histories both
# CLIs append to. Those are rewritten in place, which is safe for a writer
# that appends by path and for one that holds the file with O_APPEND alike.
ROOTS=(
  "$HOME/.claude/projects|*.jsonl|rename"
  "$HOME/.claude/history.jsonl||inplace"
  "$HOME/.codex/sessions|*.jsonl|inplace"
  "$HOME/.codex/archived_sessions|*.jsonl|rename"
  "$HOME/.codex/history.jsonl||inplace"
  "$HOME/.cursor/projects|*.jsonl|rename"
  "$HOME/.cursor/chats|prompt_history.json|rename"
  "$HOME/.cursor/chats|meta.json|rename"
  "$HOME/.cursor/chats|store.db|sqlite"
  "$HOME/.cursor/acp-sessions|store.db|sqlite"
  "$HOME/.local/share/opencode/opencode.db||sqlite"
)

# write_mode_for <path>: the write mode of the first root containing it whose
# pattern (when it has one) matches the file name.
write_mode_for() {
  local entry root pat
  for entry in "${ROOTS[@]}"; do
    root="${entry%%|*}"; pat="${entry#*|}"; pat="${pat%%|*}"
    case "$1" in "$root"|"$root"/*) ;; *) continue ;; esac
    # shellcheck disable=SC2254
    case "$(basename "$1")" in ${pat:-*}) printf '%s' "${entry##*|}"; return 0 ;; esac
  done
  printf 'rename'
}

log() { mkdir -p "$STATE" 2>/dev/null; printf '%s %s\n' "$(date -Is)" "$*" >> "$STATE/log" 2>/dev/null || true; }
# locked CMD...: runs CMD under the state lock. Exit 75 (EX_TEMPFAIL) means
# the lock was not obtained in time, so callers can tell "busy" from CMD's
# own failure; a full rescan in another container holds it for a while.
LOCK_WAIT="${REDACT_SESSIONS_LOCK_WAIT:-5}"
locked() { mkdir -p "$STATE" 2>/dev/null; ( flock -w "$LOCK_WAIT" 9 || exit 75; "$@" ) 9>>"$STATE/lock"; }
_pending_add() { grep -qx "$1" "$STATE/pending" 2>/dev/null || printf '%s\n' "$1" >> "$STATE/pending"; }
pending_add() { locked _pending_add "$1"; }

# session_of <path>: best-effort session id from the path, for the log.
session_of() {
  local b; b="$(basename "$1")"
  case "$1" in
    */subagents/*) basename "$(dirname "$(dirname "$1")")" ;;
    */agent-transcripts/*) basename "$(dirname "$1")" ;;
    */store.db) basename "$(dirname "$1")" ;;
    *) printf '%s' "${b%.jsonl}" ;;
  esac
}

# Same salt file secrets-check uses, created the same way when absent.
SALT_FILE="${AICODING_FP_SALT_FILE:-$HOME/.local/state/aicoding/secrets-check.salt}"
fingerprint_rules() {
  local salt=""
  if [ -r "$SALT_FILE" ]; then
    salt="$(cat "$SALT_FILE")"
  else
    mkdir -p "$(dirname "$SALT_FILE")" 2>/dev/null
    salt="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    ( umask 077; printf '%s' "$salt" > "$SALT_FILE" ) 2>/dev/null
  fi
  # The roots are part of the fingerprint: a root added in a new release
  # must make every old file a candidate again, exactly like a rotated key,
  # or the stores under the new root sit behind the stamp forever (found
  # deploying the sqlite roots, AICODINGBASESETUP-23).
  printf '%s%s%s' "$salt" "$RULES" "${ROOTS[*]}" | sha256sum | cut -c1-16
}

# Builds the sed script once per run. Sets RULES; returns 3 on refusal.
load_rules() {
  if ! RULES="$(redact_literal_rules sessions "$SECRETS")" \
  || ! PAIRS="$(redact_literal_rules pairs "$SECRETS")"; then
    log "refused secrets file unreadable or partially parsed; nothing touched"
    pending_add SECRETS_FILE_UNREADABLE
    echo "redact-sessions: secrets file exists but is unreadable or parsed partially; refusing" >&2
    return 3
  fi
  return 0
}

# marker_counts <file>: "KEY count" per marker found.
marker_counts() {
  grep -o '\[REDACTED:[A-Za-z_][A-Za-z0-9_,]*\]' "$1" 2>/dev/null \
    | sed 's/^\[REDACTED:\(.*\)\]$/\1/' | sort | uniq -c | awk '{print $2, $1}'
}

# _swap <file> <tmp> <sig1> <mode>: 0 swapped, 1 refused (file changed),
# 2 error. Runs under the state lock. Always consumes <tmp>.
_swap() {
  local f="$1" tmp="$2" sig1="$3" mode="$4" sig2
  sig2="$(stat -c '%i %s %Y' "$f")" || { rm -f "$tmp"; return 2; }
  if [ "$sig1" != "$sig2" ]; then rm -f "$tmp"; return 1; fi
  if [ "$mode" = inplace ]; then
    # Truncate, then append the whole replacement in ONE write(): with
    # O_APPEND on both sides the kernel serialises the two writers, so a
    # record the harness appends in the same instant lands intact before
    # or after ours instead of being overwritten. Two residual windows,
    # both microseconds wide and both accepted: an append between the
    # signature check above and the truncate is lost; one between the
    # truncate and our append is out of order but whole, and the size check
    # below logs it. Closing them needs the writer's cooperation.
    local want got
    want="$(stat -c '%s' "$tmp")"
    if ! : > "$f"; then rm -f "$tmp"; return 2; fi
    if ! dd if="$tmp" of="$f" oflag=append conv=notrunc bs="$want" count=1 status=none 2>/dev/null; then
      cat "$tmp" >> "$f"
    fi
    got="$(stat -c '%s' "$f")"
    [ "$got" = "$want" ] || log "concurrent append during in-place rewrite file=$f (record kept, order not guaranteed)"
    rm -f "$tmp"
  else
    mv -f "$tmp" "$f" || { rm -f "$tmp"; return 2; }
  fi
  return 0
}

# scrub_sqlite <db>: 0 clean or rewritten, 1 defer (python3 missing, busy,
# unknown store, helper failed, checkpoint incomplete). The helper gets the
# pairs on stdin and reports "hit KEY N [session=ID]" lines; it never sees
# the secrets file. Runs under the state lock like _swap, so two containers
# cannot rewrite the same store at once; SQLite's own lock covers the harness.
scrub_sqlite() {
  local f="$1" out rc=0 sess line key n sid
  if ! command -v "$PY" >/dev/null 2>&1; then
    [ -n "${_py_warned:-}" ] || { log "python3 missing: sqlite stores deferred"; _py_warned=1; }
    return 1
  fi
  local err; err="$(mktemp)" || return 1
  out="$(printf '%s\n' "$PAIRS" | locked "$PY" "$HELPER" "$f" 2>"$err")" || rc=$?
  local reason; reason="$(tail -n 1 "$err" 2>/dev/null)"; rm -f "$err"
  case $rc in
    0) ;;
    4) log "sqlite busy file=$f"; return 1 ;;
    5) log "sqlite unrecognised store file=$f"; return 1 ;;
    75) log "state lock busy file=$f"; return 1 ;;
    *) log "sqlite helper failed rc=$rc file=$f reason=$reason"; return 1 ;;
  esac
  sess="$(session_of "$f")"
  while IFS= read -r line; do
    case "$line" in
      hit\ *) read -r _ key n sid <<< "$line"
              log "hit key=$key count=$n file=$f container=$HOST ${sid:-session=$sess}"
              pending_add "$key" ;;
      checkpoint-incomplete) log "sqlite checkpoint incomplete file=$f (rows redacted, wal retried next sweep)"; rc=1 ;;
      skipped-table\ *) log "sqlite $line file=$f" ;;
    esac
  done <<< "$out"
  return $rc
}

# scrub_one <file>: 0 when the file is clean or was rewritten; 1 when it
# could not be handled (swap refused twice, unreadable, unwritable). Never
# touches a clean file.
scrub_one() {
  local f="$1" attempt tmp before after sig1 sess key n prev
  [ -n "$RULES" ] || return 0
  [ -f "$f" ] && [ -r "$f" ] && [ -w "$f" ] || return 1
  if [ "$(write_mode_for "$f")" = sqlite ]; then scrub_sqlite "$f"; return; fi
  for attempt in 1 2; do
    sig1="$(stat -c '%i %s %Y' "$f")" || return 1
    tmp="$(mktemp "$(dirname "$f")/.redact-sessions.XXXXXX")" || return 1
    if ! sed -E -f <(printf '%s' "$RULES") "$f" > "$tmp"; then rm -f "$tmp"; return 1; fi
    if cmp -s "$f" "$tmp"; then rm -f "$tmp"; return 0; fi
    chmod --reference="$f" "$tmp" 2>/dev/null || true
    [ -n "${REDACT_SESSIONS_RACE_HOOK:-}" ] && "$REDACT_SESSIONS_RACE_HOOK" "$f"
    before="$(marker_counts "$f")"
    after="$(marker_counts "$tmp")"
    # The final stat and the rename happen under the state lock so two
    # sweeps (from two containers, say) cannot both pass the check: the
    # loser sees the winner's rename as a changed signature and retries
    # against the already-clean file.
    locked _swap "$f" "$tmp" "$sig1" "$(write_mode_for "$f")"
    case $? in
      0) ;;
      1) log "swap refused file=$f attempt=$attempt"; continue ;;
      *) return 1 ;;
    esac
    sess="$(session_of "$f")"
    # Report the delta: markers already in the file are old news.
    while read -r key n; do
      [ -n "$key" ] || continue
      prev="$(printf '%s\n' "$before" | awk -v k="$key" '$1==k{print $2}')"
      n=$(( n - ${prev:-0} ))
      [ "$n" -gt 0 ] || continue
      local one
      for one in ${key//,/ }; do
        log "hit key=$one count=$n file=$f container=$HOST session=$sess"
        pending_add "$one"
      done
    done <<< "$after"
    return 0
  done
  return 1
}

# candidates: files newer than the stamp under every root, plus the deferred
# set. One absolute path per line; the caller deduplicates. A WAL-mode
# database commits into its -wal sibling and the main file's mtime moves only
# at checkpoint, so a -wal newer than the stamp also makes its database a
# candidate (the -wal itself is never a candidate).
candidates() {
  local entry root pat
  for entry in "${ROOTS[@]}"; do
    root="${entry%%|*}"; pat="${entry#*|}"; pat="${pat%%|*}"
    if [ -f "$root" ]; then
      if [ -e "$STATE/stamp" ]; then
        { find "$root" -newer "$STATE/stamp" 2>/dev/null
          [ -f "$root-wal" ] && [ "$root-wal" -nt "$STATE/stamp" ] && printf '%s\n' "$root"; }
      else printf '%s\n' "$root"; fi
      continue
    fi
    [ -n "$pat" ] && [ -d "$root" ] || continue
    if [ -e "$STATE/stamp" ]; then
      find "$root" -type f \( -name "$pat" -o -name "$pat-wal" \) -newer "$STATE/stamp" 2>/dev/null | sed 's/-wal$//'
    else
      find "$root" -type f -name "$pat" 2>/dev/null
    fi
  done
  [ -f "$STATE/deferred" ] && cat "$STATE/deferred"
  return 0
}

# newest_mtime <file>: mtime of the file or its -wal sibling, whichever is
# later (a WAL-mode writer touches only the -wal between checkpoints).
newest_mtime() { { stat -c '%Y' "$1" "$1-wal" 2>/dev/null || echo 0; } | sort -n | tail -1; }

sweep() {
  local start f age now inspected=0 done=0 deferred=0 list fp
  start="$(date +%s)"
  load_rules || exit 3
  mkdir -p "$STATE" 2>/dev/null || exit 0
  # No secrets file means no rules: nothing to scrub, and the stamp must
  # not advance, or the file that appears later would never see old
  # transcripts.
  if [ -z "$RULES" ]; then log "sweep skipped: no literal rules (secrets file absent)"; exit 0; fi
  # The stamp only says "inspected under the rules of that time". When the
  # rule set changes (a key added or rotated), every file is a candidate
  # again. The fingerprint is a digest of the whole rendered rule set under
  # this machine's secrets-check salt (container-local, mode 600), so the
  # persisted value cannot be used to test guesses against a weak secret;
  # it is kept per host name because the salt differs per container.
  fp="$(fingerprint_rules)"
  if [ "$(cat "$STATE/rules.fp.$HOST" 2>/dev/null)" != "$fp" ]; then
    rm -f "$STATE/stamp"
    log "rules changed: full rescan (rule set or roots differ from the stamp)"
  fi
  list="$(candidates | sort -u)"
  # A sweep killed mid-run (hook timeout) leaves its deferred.next behind.
  find "$STATE" -maxdepth 1 -name 'deferred.next.*' -mmin +60 -delete 2>/dev/null
  : > "$STATE/deferred.next.$$"
  now="$(date +%s)"
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    inspected=$(( inspected + 1 ))
    age=$(( now - $(newest_mtime "$f") ))
    if [ "$age" -lt "$QUIET" ]; then
      printf '%s\n' "$f" >> "$STATE/deferred.next.$$"; deferred=$(( deferred + 1 )); continue
    fi
    if scrub_one "$f"; then done=$(( done + 1 ))
    else printf '%s\n' "$f" >> "$STATE/deferred.next.$$"; deferred=$(( deferred + 1 )); fi
  done <<< "$list"
  mv -f "$STATE/deferred.next.$$" "$STATE/deferred"
  # find -newer compares whole seconds; back the stamp off by one so a file
  # written in the same second as this sweep started is seen next time.
  touch -d "@$(( start - 1 ))" "$STATE/stamp" 2>/dev/null || touch "$STATE/stamp"
  printf '%s\n' "$fp" > "$STATE/rules.fp.$HOST"
  log "sweep inspected=$inspected done=$done deferred=$deferred container=$HOST"
  exit 0
}

_ack() {
  [ -f "$STATE/pending" ] || return 0
  grep -vx "$1" "$STATE/pending" > "$STATE/pending.next" || true
  mv -f "$STATE/pending.next" "$STATE/pending"
}
ack() { locked _ack "$1"; log "ack key=$1 container=$HOST"; exit 0; }

usage() { sed -n '2,8p' "$_rs_self" | sed 's/^# \{0,1\}//' >&2; exit 2; }

main() {
  [ $# -ge 1 ] || usage
  local f rc=0
  case "$1" in
    --now)
      shift; [ $# -ge 1 ] || usage
      load_rules || exit 3
      for f in "$@"; do scrub_one "$f" || rc=1; done
      exit "$rc" ;;
    --sweep) shift; sweep "$@" ;;
    --ack) shift; [ $# -eq 1 ] || usage; ack "$1" ;;
    *) usage ;;
  esac
}

# Tests source this file to reach candidates(); nothing runs in that case.
[ -n "${REDACT_SESSIONS_SOURCE_ONLY:-}" ] && return 0 2>/dev/null

main "$@"
