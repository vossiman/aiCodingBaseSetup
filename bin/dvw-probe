#!/usr/bin/env python3
"""dvw-probe: describe this container from the inside as one JSON document.

Run by the dvw catalog service through `docker exec` (one exec per container)
so it can show tmux windows, running agent CLIs, git state and cgroup usage
without any other Docker API access. Contract: no arguments, one JSON object
on stdout, exit 0 in every case that reaches Python. Each section is null
when it cannot be computed; a section that overran its share of the time
budget is null and sets "partial": true.

Test hooks: DVW_PROBE_PROC, DVW_PROBE_CGROUP, DVW_PROBE_WORKSPACE,
DVW_PROBE_BUDGET (seconds), DVW_PROBE_UID (the uid to treat as "mine" in the
/proc walk, so the owner filter can be exercised without root). Spec: dvw
docs/superpowers/specs/2026-09-01-docker-proxy-probe-design.md.
"""
import json
import os
import signal
import subprocess
import sys
import time

SCHEMA = 1
AGENT_CLIS = ("claude", "codex", "cursor-agent", "opencode")
WRAPPERS = ("node", "python", "python3", "bun")

# Caps mirrored from the consumer's model (dvw catalog): a document that
# breaks them is rejected wholesale there, so truncate here instead and say
# so with "partial": true.
MAX_STR = 512
LIST_CAPS = {"agents": 64, "sessions": 64, "windows": 256}
# The catalog rejects probe stdout above this size. Character and item caps do
# not imply a byte cap: json.dumps escapes one non-ASCII character to as many
# as 12 ASCII bytes (a surrogate pair), so an otherwise valid tmux snapshot
# can exceed the consumer's limit by several times.
MAX_OUTPUT = 256 * 1024


class Budget:
    def __init__(self, seconds):
        self.end = time.monotonic() + seconds
        self.partial = False

    def remaining(self, cap):
        return max(0.0, min(cap, self.end - time.monotonic()))


def _run(argv, timeout):
    if timeout <= 0:
        raise subprocess.TimeoutExpired(argv, timeout)
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                           errors="replace")


def _int(s, default=None):
    try:
        return int(s)
    except (TypeError, ValueError):
        return default


def _budget_seconds(raw, default=3.0, lo=0.1, hi=10.0):
    try:
        seconds = float(raw)
    except (TypeError, ValueError):
        return default
    if seconds != seconds or seconds in (float("inf"), float("-inf")):  # nan/inf
        return default
    return min(max(seconds, lo), hi)


def _clean_str(s):
    """Make one string safe to serialise and short enough for the consumer.

    os.readlink, os.listdir and os.environ decode bytes with surrogateescape,
    so a path holding an invalid UTF-8 byte comes back carrying a lone
    surrogate. json.dumps happily writes that as "\\udcff", which is not valid
    JSON: a strict parser rejects the WHOLE document, so one odd byte in one
    cwd would cost every section. Round-trip through the codec to turn those
    back into U+FFFD.
    """
    return s.encode("utf-8", "surrogateescape").decode("utf-8", "replace")[:MAX_STR]


def _clean(value, key=None, flags=None):
    """Recursively sanitise strings and cap lists in the finished document."""
    if isinstance(value, str):
        return _clean_str(value)
    if isinstance(value, list):
        cap = LIST_CAPS.get(key)
        if cap is not None and len(value) > cap:
            value = value[:cap]
            flags["truncated"] = True
        return [_clean(v, None, flags) for v in value]
    if isinstance(value, dict):
        return {(_clean_str(k) if isinstance(k, str) else k): _clean(v, k, flags)
                for k, v in value.items()}
    return value


def _payload(doc):
    return (json.dumps(doc, separators=(",", ":")) + "\n").encode("utf-8")


def _fit_output(doc):
    """Serialize within MAX_OUTPUT, retaining the largest useful prefixes.

    Lists are the only fields capable of making the cleaned document large.
    Trim whichever list currently contributes the most encoded bytes, using a
    binary search so even a hostile maximum-size report remains cheap.
    """
    payload = _payload(doc)
    if len(payload) <= MAX_OUTPUT:
        return payload

    doc["partial"] = True
    tmux = doc.get("tmux") or {}
    lists = [tmux.get("windows"), tmux.get("sessions"), doc.get("agents")]
    lists = [items for items in lists if isinstance(items, list) and items]
    while len(payload) > MAX_OUTPUT and lists:
        largest = max(
            range(len(lists)),
            key=lambda i: sum(
                len(json.dumps(v).encode("utf-8")) for v in lists[i]
            ),
        )
        items = lists.pop(largest)
        original = list(items)
        lo, hi = 0, len(original)
        while lo < hi:
            keep = (lo + hi + 1) // 2
            items[:] = original[:keep]
            if len(_payload(doc)) <= MAX_OUTPUT:
                lo = keep
            else:
                hi = keep - 1
        items[:] = original[:lo]
        payload = _payload(doc)
    return payload


def collect_tmux(budget):
    per_call = budget.remaining(1.5)
    try:
        r = _run(["tmux", "list-sessions", "-F",
                  "#{session_name}\t#{session_attached}\t#{session_activity}"], per_call)
    except (OSError, subprocess.TimeoutExpired) as e:
        if isinstance(e, subprocess.TimeoutExpired):
            budget.partial = True
        return None
    if r.returncode != 0:
        return None
    sessions = []
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        sessions.append({"name": parts[0], "attached": _int(parts[1], 0),
                         "activity": _int(parts[2], -1)})
    windows = []
    if any(s["name"] == "work" for s in sessions):
        try:
            r = _run(["tmux", "list-windows", "-t", "work", "-F",
                      "#{window_id}\t#{window_name}\t#{window_active}"
                      "\t#{window_activity}\t#{@waiting}\t#{pane_current_command}"],
                     budget.remaining(1.5))
        except (OSError, subprocess.TimeoutExpired) as e:
            if isinstance(e, subprocess.TimeoutExpired):
                budget.partial = True
            return {"sessions": sessions, "windows": []}
        if r.returncode == 0:
            for line in r.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) != 6 or not parts[0].startswith("@"):
                    continue
                waiting = _int(parts[4])
                windows.append({
                    "id": parts[0], "name": parts[1], "active": parts[2] == "1",
                    "activity": _int(parts[3], -1),
                    "waiting_since": waiting if waiting is not None and waiting >= 0 else None,
                    "command": parts[5],
                })
    return {"sessions": sessions, "windows": windows}


def _read(path):
    with open(path, "rb") as f:
        return f.read()


def collect_agents(proc, budget):
    deadline = time.monotonic() + budget.remaining(1.0)
    try:
        btime = None
        for line in _read(os.path.join(proc, "stat")).decode("ascii", "replace").splitlines():
            if line.startswith("btime "):
                btime = _int(line.split()[1])
        try:
            hz = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100
        except (ValueError, OSError):
            hz = 100
        # A platform may answer -1 or None for an unsupported name; dividing
        # ticks by that would put "started" decades off instead of unknown.
        hz = hz if isinstance(hz, int) and hz > 0 else 100
        my_uid = _int(os.environ.get("DVW_PROBE_UID"), os.getuid())
        agents = []
        scanned = 0
        cut = False
        for name in os.listdir(proc):
            if time.monotonic() >= deadline:
                budget.partial = True
                cut = True
                break
            if not name.isdigit():
                continue
            scanned += 1
            pdir = os.path.join(proc, name)
            try:
                if os.stat(pdir).st_uid != my_uid:
                    continue
            except OSError:
                continue
            try:
                comm = _read(os.path.join(pdir, "comm")).decode("utf-8", "replace").strip()
                argv = _read(os.path.join(pdir, "cmdline")).split(b"\0")
            except OSError:
                continue
            argv = [a.decode("utf-8", "replace") for a in argv if a]
            cli = None
            if comm in AGENT_CLIS:
                cli = comm
            elif argv and os.path.basename(argv[0]) in AGENT_CLIS:
                cli = os.path.basename(argv[0])
            elif len(argv) > 1 and os.path.basename(argv[0]) in WRAPPERS \
                    and os.path.basename(argv[1]) in AGENT_CLIS:
                cli = os.path.basename(argv[1])
            if cli is None:
                continue
            started = None
            try:
                stat = _read(os.path.join(pdir, "stat")).decode("ascii", "replace")
                fields = stat[stat.rindex(")") + 2:].split()
                ticks = _int(fields[19])
                if btime is not None and ticks is not None:
                    started = btime + ticks // hz
            except (OSError, ValueError, IndexError):
                pass
            try:
                cwd = os.readlink(os.path.join(pdir, "cwd"))
            except OSError:
                cwd = None
            agents.append({"cli": cli, "pid": int(name), "started": started, "cwd": cwd})
        if time.monotonic() >= deadline:
            # Catches the case where the walk only went over budget on its
            # last entry (e.g. a slow read on the final pid): the loop above
            # only checks before starting a new entry, so a check is needed
            # here too or a genuinely late finish would report partial=False.
            budget.partial = True
            cut = True
        if cut and scanned == 0:
            # Nothing was looked at at all, so an empty list would read as
            # "no agents running" when the truth is "not measured": null.
            return None
        agents.sort(key=lambda a: a["pid"])
        return agents
    except OSError:
        return None


def _workspace_root():
    env = os.environ.get("DVW_PROBE_WORKSPACE") or os.environ.get("WORKSPACE_FOLDER")
    if env:
        return env if os.path.isdir(env) else None
    try:
        entries = [e for e in os.listdir("/workspaces") if os.path.isdir(os.path.join("/workspaces", e))]
    except OSError:
        return None
    return os.path.join("/workspaces", entries[0]) if len(entries) == 1 else None


def collect_git(budget):
    root = _workspace_root()
    if root is None:
        return None
    out = {"root": root, "branch": None, "head": None, "dirty": None, "ahead": None, "behind": None}

    def g(*args):
        """One git call, failing to None rather than to an exception.

        Each call is caught on its own: a timeout on the third call used to
        throw away the branch and head the first two had already produced,
        which is the opposite of what "partial" is for.
        """
        try:
            r = _run(["git", "-C", root, *args], budget.remaining(2.0))
        except subprocess.TimeoutExpired:
            budget.partial = True
            return None
        except OSError:
            # git missing altogether shows up as every call failing and the
            # section going null; only flag partial when an earlier call had
            # already collected something worth keeping.
            if any(out[k] is not None for k in ("branch", "head", "dirty")):
                budget.partial = True
            return None
        return r.stdout.strip() if r.returncode == 0 else None

    out["branch"] = g("rev-parse", "--abbrev-ref", "HEAD")
    out["head"] = g("rev-parse", "--short", "HEAD")
    # --no-optional-locks: a monitoring exec must never take index.lock or
    # rewrite the index cache under a developer working in the same repo.
    status = g("--no-optional-locks", "status", "--porcelain")
    out["dirty"] = bool(status) if status is not None else None
    counts = g("rev-list", "--left-right", "--count", "HEAD...@{upstream}")
    if counts:
        parts = counts.split()
        if len(parts) == 2:
            out["ahead"], out["behind"] = _int(parts[0]), _int(parts[1])
    if out["branch"] is None and out["head"] is None:
        return None
    return out


def collect_cgroup(cg):
    try:
        mem_max = _read(os.path.join(cg, "memory.max")).decode().strip()
        cpu_usec = None
        for line in _read(os.path.join(cg, "cpu.stat")).decode().splitlines():
            if line.startswith("usage_usec "):
                cpu_usec = _int(line.split()[1])
        return {
            "mem_current": _int(_read(os.path.join(cg, "memory.current")).decode().strip()),
            "mem_max": None if mem_max == "max" else _int(mem_max),
            "cpu_usec": cpu_usec,
            "nr_procs": _int(_read(os.path.join(cg, "pids.current")).decode().strip()),
        }
    except OSError:
        return None


def _finish(doc):
    """Sanitise, cap and serialise the document; the only way out."""
    flags = {"truncated": False}
    doc = _clean(doc, None, flags)
    if flags["truncated"]:
        doc["partial"] = True
    return _fit_output(doc).decode("utf-8")


def _arm_deadline(doc, seconds):
    """Hard backstop for the whole run.

    Every collector checks the budget before it starts a step, and every
    subprocess gets a timeout, but a plain read() on a wedged /proc entry
    (or an open() on something that turns out to be a FIFO) has no timeout
    at all and used to hold the probe for as long as the kernel liked. The
    timer fires SIGALRM, which interrupts that syscall; the handler writes
    whatever sections were finished by then, flagged partial, and leaves
    through os._exit so no half-collected section gets a second chance to
    block. A small grace on top of the budget covers serialisation.
    """
    def fire(signum, frame):
        try:
            doc["partial"] = True
            payload = _finish(doc)
        except Exception:
            payload = json.dumps({"schema": SCHEMA, "ts": int(time.time()),
                                  "partial": True, "tmux": None, "agents": None,
                                  "git": None, "cgroup": None},
                                 separators=(",", ":")) + "\n"
        try:
            sys.stdout.write(payload)
            sys.stdout.flush()
        except Exception:
            pass
        os._exit(0)

    signal.signal(signal.SIGALRM, fire)
    signal.setitimer(signal.ITIMER_REAL, seconds + 0.25)


def main():
    if len(sys.argv) > 1:
        print(json.dumps({"schema": SCHEMA, "error": "dvw-probe takes no arguments"}))
        return 0
    try:
        seconds = _budget_seconds(os.environ.get("DVW_PROBE_BUDGET", "3"))
        budget = Budget(seconds)
        proc = os.environ.get("DVW_PROBE_PROC", "/proc")
        cg = os.environ.get("DVW_PROBE_CGROUP", "/sys/fs/cgroup")
        doc = {"schema": SCHEMA, "ts": int(time.time()), "partial": False,
               "tmux": None, "agents": None, "git": None, "cgroup": None}
        _arm_deadline(doc, seconds)
        for key, fn in (("cgroup", lambda: collect_cgroup(cg)),
                        ("agents", lambda: collect_agents(proc, budget)),
                        ("tmux", lambda: collect_tmux(budget)),
                        ("git", lambda: collect_git(budget))):
            try:
                doc[key] = fn()
            except Exception:  # a collector must never take the document down
                doc[key] = None
                budget.partial = True  # a crashed collector is not "measured"
        # Collection is over; from here on the deadline handler would only
        # race the normal exit and print the document twice.
        signal.setitimer(signal.ITIMER_REAL, 0)
        doc["partial"] = budget.partial
        payload = _finish(doc)
    except Exception:
        # Anything unexpected outside the collectors (a broken environment,
        # a serialisation surprise) still owes the caller one valid document.
        try:
            ts = int(time.time())
        except Exception:
            ts = 0
        payload = json.dumps({"schema": SCHEMA, "ts": ts, "partial": True,
                              "tmux": None, "agents": None, "git": None,
                              "cgroup": None}, separators=(",", ":")) + "\n"
    try:
        sys.stdout.write(payload)
        sys.stdout.flush()
    except Exception:
        pass  # the reader went away; nothing more we can do about it
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    finally:
        # Python's own shutdown sequence flushes stdout again; if the reader
        # is already gone that raises BrokenPipeError past our own guard in
        # main() and turns exit 0 into exit 120. Redirecting the fd to
        # /dev/null first makes that final flush a no-op.
        try:
            sys.stdout.flush()
        except OSError:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
            os.close(devnull)
