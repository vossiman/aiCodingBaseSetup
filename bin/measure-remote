#!/usr/bin/env python3
"""Drive memory-lanes measurement runs on vossisrv over a restricted SSH key.

Same shape as kanban-post and git-credential-aicoding: the credential (here a
private key under ~/.aicodingsetup) is used inside this process and never
appears in a command an agent writes, which is what lets an agent call this
under the secrets deny rules. The key is command=-restricted server-side:
sshd runs the memory-lanes forced command (memory-lanes:
scripts/measure-remote-server.sh) with whatever verb is sent, so no shell
and no file transfer exist on this channel whatever the client asks for.

Usage:
  measure-remote start LABEL LANES KEY_LIMIT MODE [GRANULARITY]
  measure-remote status
  measure-remote log [N]
  measure-remote results LABEL
  measure-remote cancel
  measure-remote recover-falkordb
  measure-remote stop-paid

The server validates every argument again; this client only refuses what it
can see is malformed so a typo does not cost a round trip.
"""
import os
import pathlib
import re
import subprocess
import sys

KEY = pathlib.Path.home() / ".aicodingsetup" / "memory-lanes-measure"
DEFAULT_TARGET = "vossi@10.0.0.249"
VERBS = ("start", "status", "log", "results", "cancel", "recover-falkordb", "stop-paid")
LABEL = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
LANE = re.compile(r"^(vector|cognee|graphiti|hindsight)(,(vector|cognee|graphiti|hindsight))*$")
MONEY = re.compile(r"^[0-9]{1,3}(\.[0-9]{1,2})?$")


def die(message: str, code: int = 2) -> "NoReturn":  # noqa: F821
    print(f"measure-remote: {message}", file=sys.stderr)
    sys.exit(code)


def validate(argv: list[str]) -> None:
    verb = argv[0]
    if verb == "start":
        if len(argv) not in (5, 6):
            die("usage: start LABEL LANES KEY_LIMIT MODE [GRANULARITY]")
        _, label, lanes, limit, mode, *rest = argv
        if not LABEL.match(label):
            die("label: lowercase letters, digits, dashes, max 40")
        if not LANE.match(lanes):
            die("lanes: comma list of vector,cognee,graphiti,hindsight")
        if not MONEY.match(limit):
            die("key limit: USD, e.g. 12.50")
        if mode not in ("full", "delta"):
            die("mode: full or delta")
        if rest and rest[0] not in ("section", "unit"):
            die("granularity: section or unit")
    elif verb == "results":
        if len(argv) != 2 or not LABEL.match(argv[1]):
            die("usage: results LABEL")
    elif verb == "log":
        if len(argv) > 2 or (len(argv) == 2 and not argv[1].isdigit()):
            die("usage: log [N]")
    elif len(argv) != 1:
        die(f"{verb} takes no arguments")


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] not in VERBS:
        die(f"unknown verb {argv[0]!r}; one of {', '.join(VERBS)}")
    validate(argv)
    if not KEY.is_file():
        die(f"no key at {KEY}; the owner installs it on the host side (see memory-lanes docs/runbooks/measure-remote.md)")
    target = os.environ.get("MEASURE_REMOTE_TARGET", DEFAULT_TARGET)
    ssh = [
        "ssh",
        "-i", str(KEY),
        "-o", "IdentitiesOnly=yes",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=10",
        "-o", "StrictHostKeyChecking=accept-new",
        target,
        "--",
        *argv,
    ]
    try:
        return subprocess.call(ssh)
    except OSError as exc:
        die(f"could not run ssh: {exc.strerror}", 1)


if __name__ == "__main__":
    sys.exit(main())
