#!/usr/bin/env python3
"""Write to the kanban board without any agent handling the bearer token.

Same shape as git-credential-aicoding: the credential is read from the
estate's secrets store inside this process and used to build one request. It
never appears in argv, in a file, or in this program's output -- which is
what lets an agent use it under the secrets deny rules, instead of expanding
$KANBAN_TOKEN into a shell command the hook (correctly) refuses.

This file is intended to ship in a PUBLIC repo. It contains no credential:
only the path to the store, and the rules below that keep the value from
escaping.

  1. The destination host is pinned to DEFAULT_URL. KANBAN_URL overrides it
     only for a loopback test server, and when it does, the credential must
     be injected via KANBAN_TEST_TOKEN -- the protected store is not read.
     So no environment variable can redirect the token to another host.
  2. Redirects are refused. urllib re-sends Authorization to whatever a
     redirect names, including another origin; that is the classic way a
     bearer token leaks. A 3xx is an error here, not something to follow.
  3. Nothing prints a traceback. An unexpected exception exits with a short
     message, so no frame dump can carry the request object into a log.

Usage:
  kanban-post "title" --repo NAME [--body TEXT] [--status KEY] [--priority P] [--swimlane KEY] [--due DATE]
  kanban-post --patch TICKET ["new title"] [--body TEXT] [--status KEY] [--priority P] [--swimlane KEY] [--due DATE|none]
  kanban-post --done TICKET
  kanban-post --done TICKET --evidence TEXT [--reference TEXT ...]
  kanban-post --comment TICKET "text" | --comment TICKET --body TEXT
  kanban-post --link TICKET --depends-on OTHER | --blocks OTHER | --relates OTHER
  kanban-post --unlink TICKET OTHER
  kanban-post --list-repos | --list-tickets
  kanban-post --json OPERATION  # reads one JSON object from stdin
  kanban-post --selftest        # proves the token cannot reach the output

--repo is required and must name the repo this checkout belongs to; see
derive_repo() for why it is both stated and proved.

TICKET is an issue key (DEVMACHINE-12, case-insensitive) or the ticket's
uuid. The board accepts either; quote the key when writing for a human.
"""
import argparse
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "https://kanban.dataprospectors.at"
SECRETS = pathlib.Path.home() / ".aicodingsetup" / ".secrets.env"
LOOPBACK = {"127.0.0.1", "localhost", "::1"}
MAX_JSON_STDIN = 256 * 1024
MAX_OPAQUE = 300
STATUSES = {"backlog", "todo", "doing", "done"}
PRIORITIES = {"low", "normal", "high"}
SWIMLANES = {"required", "nice_to_have", "waiting_for_feedback", "needs_decision"}
HARNESSES = {"claude", "codex", "cursor", "opencode"}
JSON_OPERATIONS = {
    "list_repos", "list_tickets", "get_ticket", "create_ticket", "update_ticket",
    "add_comment", "link_tickets", "unlink_tickets", "register_session", "get_session",
    "rebind_session", "end_session", "claim_ticket", "activity", "checkpoint_work",
    "release_ticket", "complete_ticket", "override_claim",
}


class InputError(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


def die(message: str) -> "NoReturn":  # noqa: F821
    """Exit with a short message. Never raises through to a traceback, and
    never carries a credential: callers pass their own text, and scrub() is
    deliberately NOT used here because die() is what scrub() falls back to
    when the store is unreadable."""
    sys.exit(f"kanban-post: {message}")


def base_url() -> str:
    """The board's address. The destination is PINNED.

    KANBAN_URL exists for the test server and nothing else: it is honoured
    only for a loopback address. An https override used to be accepted,
    which meant one environment variable could aim the bearer token at any
    host on the internet -- the deny hook cannot help, because setting
    KANBAN_URL names no secret. Loopback-only is what makes the docstring's
    promise true.
    """
    override = os.environ.get("KANBAN_URL")
    if not override:
        return DEFAULT_URL
    url = override.rstrip("/")
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in {"http", "https"}:
        die("KANBAN_URL must use http or https")
    if (parts.hostname or "") in LOOPBACK:
        return url
    die(
        "KANBAN_URL may only name a loopback test server; refusing to send "
        f"a bearer token to {parts.hostname or 'a schemeless URL'}"
    )


def token() -> str:
    """Read the credential. Returned to exactly one caller, which puts it in
    a header and drops it.

    When KANBAN_URL is set we are talking to a test server, and the real
    credential has no business being in that request: the value must be
    injected through KANBAN_TEST_TOKEN instead. This is belt to
    base_url()'s braces -- even if a loopback destination were somehow
    hostile, it would receive a fake.
    """
    if os.environ.get("KANBAN_URL"):
        value = os.environ.get("KANBAN_TEST_TOKEN", "")
        if not value:
            die(
                "KANBAN_URL is set, so this is a test run; supply a fake "
                "credential in KANBAN_TEST_TOKEN. The protected store is "
                "not read for a test destination."
            )
        return value
    if not SECRETS.is_file():
        die(f"no secrets store at {SECRETS}")
    for line in SECRETS.read_text().splitlines():
        line = line.strip()
        if line.startswith("KANBAN_TOKEN="):
            value = line.split("=", 1)[1].strip().strip('"').strip("'")
            if value:
                return value
            break
    die("KANBAN_TOKEN is not set in the secrets store")


GITHUB_REMOTE = re.compile(
    r"^(?:https://|ssh://git@|git@)github\.com[:/]"
    r"[^/]+/(?P<name>[^/]+?)(?:\.git)?/?$"
)


def derive_repo(checkout: str | None = None) -> str | None:
    """The repo name this checkout belongs to, from its github.com origin.

    Every ticket carries a repo tag, and that tag is what the phone view
    filters on -- so a wrong one is worse than no ticket. --repo says which
    repo the caller means; this says which repo they are actually in, and
    the two must agree. An agent that has lost track of its own cwd fails
    loudly instead of filing into someone else's backlog.

    It is also the authority on spelling. The board's names come from
    `gh repo list` (kanban backend/app/cli.py, seed-repos), so `dataEnv` is
    the canonical form and a registered `dataenv` would be a second repo
    that looks like the first.

    None means "no github.com origin here", which is a refusal rather than
    a guess -- filing needs a checkout.
    """
    try:
        p = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True, text=True, timeout=10,
            cwd=checkout,
        )
    except Exception:
        return None
    if p.returncode != 0:
        return None
    match = GITHUB_REMOTE.match(p.stdout.strip())
    return match.group("name") if match else None


def scrub(text: str) -> str:
    """Last line of defence before anything is printed.

    A server can put the credential back in front of us -- an error page that
    dumps request headers, a proxy that echoes them, a validation error
    quoting the request. Everything this program prints goes through here, so
    a spill needs the redaction to fail, not merely a server to misbehave.
    """
    try:
        secret = token()
    except SystemExit:
        return text
    return text.replace(secret, "<redacted>") if secret else text


def emit(value) -> None:
    text = json.dumps(value, indent=2) if isinstance(value, (dict, list)) else str(value)
    print(scrub(text))


def emit_json(ok: bool, *, data=None, code=None, message=None) -> None:
    value = {"ok": True, "data": data} if ok else {
        "ok": False, "error": {"code": code, "message": message}
    }
    print(scrub(json.dumps(value, separators=(",", ":"))))


class NoRedirects(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect. Following one would re-send Authorization to
    whatever host the response named."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        die(f"refusing to follow a {code} redirect to another location")


def call(method: str, path: str, payload: dict | None = None):
    req = urllib.request.Request(
        f"{base_url()}{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={
            "Authorization": f"Bearer {token()}",
            "Content-Type": "application/json",
        },
        method=method,
    )
    opener = urllib.request.build_opener(NoRedirects)
    try:
        with opener.open(req, timeout=30) as r:
            body = r.read()
            # 204 (a DELETE) carries no body.
            return r.status, json.loads(body) if body else None
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        try:
            body = json.loads(body)
        except ValueError:
            pass
        return e.code, body
    except urllib.error.URLError as e:
        die(f"cannot reach the board: {e.reason}")
    except Exception as e:  # deliberately broad: never surface a traceback
        die(f"request failed: {type(e).__name__}")


def _shape(operation: str, payload: dict, required=(), optional=()) -> dict:
    allowed = set(required) | set(optional)
    unknown = sorted(set(payload) - allowed)
    if unknown:
        raise InputError(422, f"unknown field {unknown[0]!r} for {operation}")
    missing = [name for name in required if name not in payload]
    if missing:
        raise InputError(422, f"missing field {missing[0]!r} for {operation}")
    return payload


def _text(value, name: str, *, maximum=MAX_OPAQUE, blank=False) -> str:
    if not isinstance(value, str) or len(value) > maximum or (not blank and not value.strip()):
        qualifier = f"a nonempty string of at most {maximum} characters"
        raise InputError(422, f"{name} must be {qualifier}")
    return value


def _optional_text(value, name: str, *, maximum=MAX_OPAQUE, blank=False):
    return None if value is None else _text(value, name, maximum=maximum, blank=blank)


def _enum(value, name: str, choices: set[str]) -> str:
    if not isinstance(value, str) or value not in choices:
        raise InputError(422, f"{name} must be one of {', '.join(sorted(choices))}")
    return value


def _date(value, name="due_date"):
    if value is None:
        return None
    value = _text(value, name)
    try:
        parsed = datetime.date.fromisoformat(value)
    except ValueError:
        raise InputError(422, f"{name} must be a date in YYYY-MM-DD form") from None
    if parsed.isoformat() != value:
        raise InputError(422, f"{name} must be a date in YYYY-MM-DD form")
    return value


def _timestamp(value, name="observed_at") -> str:
    value = _text(value, name)
    try:
        datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        raise InputError(422, f"{name} must be an ISO 8601 timestamp") from None
    return value


def _operation_id(payload: dict) -> str:
    return _text(payload["operation_id"], "operation_id")


def _segment(value, name: str) -> str:
    return urllib.parse.quote(_text(value, name), safe="")


def _check_optional_enums(payload: dict) -> None:
    if payload.get("status") is not None:
        _enum(payload["status"], "status", STATUSES)
    if payload.get("priority") is not None:
        _enum(payload["priority"], "priority", PRIORITIES)
    if payload.get("swimlane") is not None:
        _enum(payload["swimlane"], "swimlane", SWIMLANES)
    if "due_date" in payload:
        _date(payload["due_date"])


def _request(operation: str, method: str, path: str, body=None) -> tuple[int, object]:
    status, result = call(method, path, body)
    return status, result


def dispatch_json(operation: str, payload: dict) -> tuple[int, object]:
    """Validate one public operation and map it to its fixed board request."""
    if operation not in JSON_OPERATIONS:
        raise InputError(422, f"unknown operation {operation!r}")

    if operation == "list_repos":
        _shape(operation, payload)
        return _request(operation, "GET", "/api/repos")

    if operation == "list_tickets":
        _shape(operation, payload, optional=("repo", "status", "swimlane", "done"))
        if payload.get("repo") is not None:
            _text(payload["repo"], "repo")
        if payload.get("status") is not None:
            _enum(payload["status"], "status", STATUSES)
        if payload.get("swimlane") is not None:
            _enum(payload["swimlane"], "swimlane", SWIMLANES)
        if payload.get("done") is not None:
            _enum(payload["done"], "done", {"all", "recent"})
        query = urllib.parse.urlencode([
            (name, payload[name]) for name in ("repo", "status", "swimlane", "done")
            if payload.get(name) is not None
        ])
        return _request(operation, "GET", "/api/tickets" + (f"?{query}" if query else ""))

    if operation == "get_ticket":
        _shape(operation, payload, required=("ticket",))
        return _request(operation, "GET", f"/api/tickets/{_segment(payload['ticket'], 'ticket')}")

    if operation == "create_ticket":
        _shape(operation, payload, required=("checkout", "title"),
               optional=("body", "status", "priority", "swimlane", "due_date"))
        checkout = _text(payload["checkout"], "checkout", maximum=4096)
        if not os.path.isabs(checkout):
            raise InputError(422, "checkout must be an absolute path")
        repo = derive_repo(checkout)
        if repo is None:
            raise InputError(422, "checkout is not a repository with a github.com origin")
        body = {"repo": repo, "title": _text(payload["title"], "title", maximum=10_000)}
        _check_optional_enums(payload)
        for name in ("body", "status", "priority", "swimlane", "due_date"):
            if name in payload:
                if name == "body":
                    _optional_text(payload[name], name, maximum=100_000, blank=True)
                body[name] = payload[name]
        return _request(operation, "POST", "/api/tickets", body)

    if operation == "update_ticket":
        _shape(operation, payload, required=("ticket", "fields"))
        fields = payload["fields"]
        if not isinstance(fields, dict):
            raise InputError(422, "fields must be an object")
        _shape(operation, fields, optional=("title", "body", "status", "priority", "swimlane", "due_date", "position"))
        _check_optional_enums(fields)
        if "title" in fields:
            _text(fields["title"], "title", maximum=10_000)
        if "body" in fields:
            _optional_text(fields["body"], "body", maximum=100_000, blank=True)
        if "position" in fields and (isinstance(fields["position"], bool) or not isinstance(fields["position"], int) or fields["position"] < 0):
            raise InputError(422, "position must be a nonnegative integer")
        return _request(operation, "PATCH", f"/api/tickets/{_segment(payload['ticket'], 'ticket')}", fields)

    if operation == "add_comment":
        _shape(operation, payload, required=("ticket", "body"))
        body = _text(payload["body"], "body", maximum=100_000)
        return _request(operation, "POST", f"/api/tickets/{_segment(payload['ticket'], 'ticket')}/comments", {"body": body})

    if operation == "link_tickets":
        _shape(operation, payload, required=("ticket", "target", "kind"))
        target = _text(payload["target"], "target")
        kind = _enum(payload["kind"], "kind", {"depends_on", "blocks", "relates"})
        return _request(operation, "POST", f"/api/tickets/{_segment(payload['ticket'], 'ticket')}/links",
                        {"target": target, "kind": kind})

    if operation == "unlink_tickets":
        _shape(operation, payload, required=("ticket", "target"), optional=("kind",))
        ticket = _text(payload["ticket"], "ticket")
        target = _text(payload["target"], "target")
        kind = payload.get("kind")
        if kind is not None:
            _enum(kind, "kind", {"depends_on", "blocks", "relates"})
        status, current = _request(operation, "GET", f"/api/tickets/{urllib.parse.quote(ticket, safe='')}")
        if status >= 400:
            return status, current
        links = current.get("links", []) if isinstance(current, dict) else []
        target_upper = target.upper()
        matches = [link for link in links
                   if target_upper in (str(link.get("ticket", {}).get("key", "")).upper(),
                                       str(link.get("ticket", {}).get("id", "")).upper())
                   and (kind is None or link.get("kind") == kind)]
        if not matches:
            raise InputError(404, f"{ticket} has no matching link to {target}")
        if len(matches) > 1:
            raise InputError(409, f"{ticket} has more than one link to {target}; specify kind")
        link_id = _segment(str(matches[0].get("id", "")), "link id")
        return _request(operation, "DELETE", f"/api/tickets/{urllib.parse.quote(ticket, safe='')}/links/{link_id}")

    if operation == "register_session":
        required = ("harness", "native_session_id", "run_generation", "label", "repo", "lifecycle_capable", "operation_id")
        _shape(operation, payload, required=required, optional=("subagent_id",))
        _enum(payload["harness"], "harness", HARNESSES)
        _text(payload["native_session_id"], "native_session_id")
        _optional_text(payload.get("subagent_id"), "subagent_id")
        _text(payload["run_generation"], "run_generation")
        _text(payload["label"], "label")
        _text(payload["repo"], "repo")
        if type(payload["lifecycle_capable"]) is not bool:
            raise InputError(422, "lifecycle_capable must be a boolean")
        _operation_id(payload)
        return _request(operation, "POST", "/api/work/sessions", payload)

    if operation == "get_session":
        _shape(operation, payload, required=("work_session_id",))
        session = _text(payload["work_session_id"], "work_session_id")
        return _request(operation, "GET", f"/api/work/sessions/{urllib.parse.quote(session, safe='')}")

    if operation == "rebind_session":
        _shape(operation, payload, required=("work_session_id", "repo", "operation_id"), optional=("label",))
        session = _text(payload["work_session_id"], "work_session_id")
        _text(payload["repo"], "repo")
        _optional_text(payload.get("label"), "label")
        _operation_id(payload)
        body = {key: value for key, value in payload.items() if key != "work_session_id"}
        return _request(operation, "POST", f"/api/work/sessions/{urllib.parse.quote(session, safe='')}/rebind", body)

    if operation == "end_session":
        _shape(operation, payload, required=("work_session_id", "operation_id"), optional=("handoff",))
        session = _text(payload["work_session_id"], "work_session_id")
        _operation_id(payload)
        _optional_text(payload.get("handoff"), "handoff", maximum=10_000)
        body = {key: value for key, value in payload.items() if key != "work_session_id"}
        return _request(operation, "POST", f"/api/work/sessions/{urllib.parse.quote(session, safe='')}/end", body)

    if operation == "claim_ticket":
        _shape(operation, payload, required=("work_session_id", "ticket", "operation_id"))
        session = _text(payload["work_session_id"], "work_session_id")
        _operation_id(payload)
        body = {"work_session_id": session, "operation_id": payload["operation_id"]}
        return _request(operation, "POST", f"/api/work/tickets/{_segment(payload['ticket'], 'ticket')}/claim", body)

    if operation in {"activity", "checkpoint_work", "release_ticket", "complete_ticket"}:
        required = {
            "activity": ("work_session_id", "claim_id", "observed_at", "sequence", "operation_id"),
            "checkpoint_work": ("work_session_id", "claim_id", "checkpoint", "operation_id"),
            "release_ticket": ("work_session_id", "claim_id", "handoff", "reason", "operation_id"),
            "complete_ticket": ("work_session_id", "claim_id", "evidence", "operation_id"),
        }[operation]
        optional = {
            "activity": (), "checkpoint_work": (),
            "release_ticket": ("feedback_target", "swimlane"),
            "complete_ticket": ("references",),
        }[operation]
        _shape(operation, payload, required=required, optional=optional)
        _text(payload["work_session_id"], "work_session_id")
        claim = _text(payload["claim_id"], "claim_id")
        _operation_id(payload)
        body = {key: value for key, value in payload.items() if key != "claim_id"}
        if operation == "activity":
            _timestamp(payload["observed_at"])
            if isinstance(payload["sequence"], bool) or not isinstance(payload["sequence"], int) or payload["sequence"] < 0:
                raise InputError(422, "sequence must be a nonnegative integer")
        elif operation == "checkpoint_work":
            _text(payload["checkpoint"], "checkpoint", maximum=10_000)
        elif operation == "release_ticket":
            _text(payload["handoff"], "handoff", maximum=10_000)
            reason = _enum(payload["reason"], "reason", {"paused", "feedback", "stopped"})
            feedback = _optional_text(payload.get("feedback_target"), "feedback_target", maximum=1_000)
            if reason == "feedback" and feedback is None:
                raise InputError(422, "feedback_target is required when reason is 'feedback'")
            if reason != "feedback" and feedback is not None:
                raise InputError(422, "feedback_target requires reason 'feedback'")
            if payload.get("swimlane") is not None:
                swimlane = _enum(payload["swimlane"], "swimlane", SWIMLANES)
                if swimlane == "waiting_for_feedback":
                    raise InputError(422, "swimlane must name the prior lane")
        else:
            _text(payload["evidence"], "evidence", maximum=10_000)
            references = payload.get("references", [])
            if not isinstance(references, list) or len(references) > 50:
                raise InputError(422, "references must be a list of at most 50 strings")
            for reference in references:
                _text(reference, "reference", maximum=1_000)
            body["references"] = references
        suffix = {"activity": "activity", "checkpoint_work": "checkpoint", "release_ticket": "release", "complete_ticket": "complete"}[operation]
        return _request(operation, "POST", f"/api/work/claims/{urllib.parse.quote(claim, safe='')}/{suffix}", body)

    # override_claim is the only remaining allowlisted operation.
    _shape(operation, payload, required=("claim_id", "reason", "operation_id"),
           optional=("status", "swimlane", "position"))
    claim = _text(payload["claim_id"], "claim_id")
    _text(payload["reason"], "reason", maximum=10_000)
    _operation_id(payload)
    _check_optional_enums(payload)
    if "position" in payload and (isinstance(payload["position"], bool) or not isinstance(payload["position"], int) or payload["position"] < 0):
        raise InputError(422, "position must be a nonnegative integer")
    body = {key: value for key, value in payload.items() if key != "claim_id"}
    return _request(operation, "POST", f"/api/work/claims/{urllib.parse.quote(claim, safe='')}/override", body)


def _error_message(value) -> str:
    if isinstance(value, dict):
        detail = value.get("detail")
        if isinstance(detail, str):
            return detail
        if detail is not None:
            return json.dumps(detail, separators=(",", ":"))
    if isinstance(value, str):
        return value
    return f"board returned HTTP error"


def run_json_mode(operation: str) -> int:
    try:
        raw = sys.stdin.buffer.read(MAX_JSON_STDIN + 1)
        if len(raw) > MAX_JSON_STDIN:
            raise InputError(422, "stdin exceeds 256 KiB")
        try:
            payload = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise InputError(422, "stdin must contain one valid JSON object") from None
        if not isinstance(payload, dict):
            raise InputError(422, "stdin must contain one JSON object")
        status, data = dispatch_json(operation, payload)
        if status >= 400:
            emit_json(False, code=status, message=_error_message(data))
            return 1
        emit_json(True, data=data)
        return 0
    except InputError as error:
        emit_json(False, code=error.code, message=error.message)
        return 1
    except SystemExit as error:
        message = str(error.code)
        if message.startswith("kanban-post: "):
            message = message[len("kanban-post: "):]
        emit_json(False, code=502, message=message)
        return 1
    except urllib.error.HTTPError as error:
        emit_json(False, code=error.code, message=f"HTTP {error.code}")
        return 1
    except urllib.error.URLError as error:
        emit_json(False, code=502, message=f"cannot reach the board: {error.reason}")
        return 1
    except Exception as error:
        emit_json(False, code=500, message=type(error).__name__)
        return 1


def run_kanban_work(operation: str, payload: dict) -> dict:
    try:
        result = subprocess.run(
            ["kanban-work", "--json", operation],
            input=json.dumps(payload, separators=(",", ":")),
            capture_output=True, text=True, timeout=30,
        )
        envelope = json.loads(result.stdout)
        if not isinstance(envelope, dict):
            raise ValueError("non-object envelope")
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError) as error:
        die(f"kanban-work failed: {type(error).__name__}")
    if result.returncode != 0 or not envelope.get("ok"):
        detail = envelope.get("error", {})
        message = detail.get("message") if isinstance(detail, dict) else None
        die(message or "kanban-work rejected the operation")
    if not isinstance(envelope.get("data"), dict):
        die("kanban-work returned an invalid success envelope")
    return envelope


def selftest() -> int:
    """Prove the token cannot reach stdout/stderr, and that a redirect to
    another origin is refused rather than followed.

    Runs against a throwaway local server with a fake credential; touches
    neither the real board nor the real secrets store.
    """
    import http.server
    import subprocess
    import tempfile
    import threading

    fake = "FAKE-TOKEN-cf4d1a9e-do-not-use"
    seen: list[str] = []

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _record(self):
            seen.append(self.headers.get("Authorization", ""))

        def do_GET(self):
            self._record()
            if self.path.startswith("/redirect"):
                self.send_response(302)
                self.send_header("Location", "http://127.0.0.1:1/stolen")
                self.end_headers()
                return
            self.send_response(500)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            # A hostile or buggy server echoing the credential back must not
            # end up printed either.
            self.wfile.write(json.dumps({"detail": self.headers.get("Authorization")}).encode())

        do_POST = do_GET

    srv = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    port = srv.server_address[1]

    home = tempfile.mkdtemp()
    store = pathlib.Path(home) / ".aicodingsetup"
    store.mkdir()
    (store / ".secrets.env").write_text(f"OTHER=x\nKANBAN_TOKEN={fake}\n")

    env = {
        **os.environ,
        "HOME": home,
        "KANBAN_URL": f"http://127.0.0.1:{port}",
        "KANBAN_TEST_TOKEN": fake,
    }
    failures = []

    def run(args, label, input_data=None):
        p = subprocess.run(
            [sys.executable, __file__, *args],
            input=input_data, capture_output=True, text=True, env=env, timeout=30,
        )
        out = p.stdout + p.stderr
        if fake in out:
            failures.append(f"{label}: the token appeared in the output")
        return out

    run(["--list-tickets"], "error body echoing the credential")
    before_json_read = len(seen)
    run(["--json", "list_repos"], "JSON read", "{}")
    if len(seen) != before_json_read + 1:
        failures.append("JSON read: did not make exactly one request")
    # Lifecycle JSON uses only the fake backend identity and fake token.
    lifecycle = subprocess.run(
        [sys.executable, __file__, "--json", "claim_ticket"],
        input=json.dumps({
            "work_session_id": "11111111-1111-4111-8111-111111111111",
            "ticket": "SELFTEST-1",
            "operation_id": "selftest-claim",
        }), capture_output=True, text=True, env=env, timeout=30,
    )
    if fake in lifecycle.stdout + lifecycle.stderr:
        failures.append("JSON lifecycle: the token appeared in the output")
    if len(seen) != before_json_read + 2:
        failures.append("JSON lifecycle: did not make exactly one request")
    # A write path, chosen over filing a ticket because --done needs no
    # checkout to derive a repo name from -- the redaction it exercises is
    # the same call()/emit() pair either way.
    run(["--done", "some-ticket-id"], "PATCH error path")
    run(["--link", "A-1", "--relates", "B-2"], "link error path")
    run(["--unlink", "A-1", "B-2"], "unlink lookup error path")

    env["KANBAN_URL"] = f"http://127.0.0.1:{port}/redirect"
    before = len(seen)
    out = run(["--list-tickets"], "redirect")
    if "refusing to follow" not in out:
        failures.append("redirect: was not refused")
    if len(seen) > before + 1:
        failures.append("redirect: Authorization was re-sent to the new location")

    env["KANBAN_URL"] = "https://kanban.example.invalid"
    out = run(["--list-tickets"], "arbitrary https host")
    if "loopback" not in out:
        failures.append("destination: an arbitrary https host was not refused")

    srv.shutdown()
    for f in failures:
        print("FAIL", f)
    if failures:
        return 1
    print("selftest: ok — token never reached the output; "
          "redirects refused; non-loopback destinations refused")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="kanban-post")
    p.add_argument("title", nargs="?")
    p.add_argument("--repo", default=None)
    p.add_argument("--body", default=None)
    p.add_argument("--status", default=None)
    p.add_argument("--priority", default=None)
    p.add_argument("--swimlane", default=None,
                   choices=("required", "nice_to_have", "waiting_for_feedback", "needs_decision"),
                   help="explicit classification; omitted new tickets default to needs_decision")
    p.add_argument("--due", metavar="DATE", default=None,
                   help="due date, YYYY-MM-DD; with --patch, 'none' clears it")
    p.add_argument("--patch", metavar="TICKET", default=None,
                   help="issue key (DEVMACHINE-12) or ticket uuid")
    p.add_argument("--done", metavar="TICKET", default=None,
                   help="issue key (DEVMACHINE-12) or ticket uuid")
    p.add_argument("--comment", metavar="TICKET", default=None,
                   help="issue key (DEVMACHINE-12) or ticket uuid")
    p.add_argument("--link", metavar="TICKET", default=None,
                   help="link TICKET to another; pair with exactly one of the kind flags")
    p.add_argument("--depends-on", metavar="OTHER", default=None,
                   help="TICKET waits for OTHER; the board shows TICKET as blocked until OTHER is done")
    p.add_argument("--blocks", metavar="OTHER", default=None,
                   help="OTHER waits for TICKET")
    p.add_argument("--relates", metavar="OTHER", default=None,
                   help="plain see-also link, no direction")
    p.add_argument("--unlink", metavar="TICKET", default=None,
                   help="remove the link between TICKET and OTHER (given positionally)")
    p.add_argument("--list-repos", action="store_true")
    p.add_argument("--list-tickets", action="store_true")
    p.add_argument("--json", metavar="OPERATION", default=None,
                   help="read one operation payload as JSON from stdin")
    p.add_argument("--evidence", default=None,
                   help="completion evidence for --done")
    p.add_argument("--reference", action="append", default=None,
                   help="completion reference; repeat as needed")
    p.add_argument("--work-handle", default=None, help=argparse.SUPPRESS)
    p.add_argument("--selftest", action="store_true")
    a = p.parse_args()

    if a.json is not None:
        return run_json_mode(a.json)

    if (a.evidence is not None or a.reference or a.work_handle) and not a.done:
        p.error("--evidence, --reference and --work-handle only apply to --done")
    if (a.reference or a.work_handle) and a.evidence is None:
        p.error("--reference and --work-handle require --done --evidence")

    if a.swimlane is not None and (a.comment or a.link or a.unlink or a.list_repos or a.list_tickets or a.selftest):
        p.error("--swimlane only applies to creating or patching a ticket")

    kinds = {k: getattr(a, k) for k in ("depends_on", "blocks", "relates") if getattr(a, k)}
    if kinds and not a.link:
        p.error("--depends-on, --blocks and --relates go with --link TICKET")
    if (a.link or a.unlink) and (a.patch or a.done or a.comment or a.repo):
        p.error("--link/--unlink only change links; drop --patch, --done, --comment and --repo")
    if a.link and a.unlink:
        p.error("--link and --unlink are alternatives")

    if a.selftest:
        return selftest()
    if a.list_repos:
        status, out = call("GET", "/api/repos")
    elif a.list_tickets:
        status, out = call("GET", "/api/tickets")
    elif a.link:
        if len(kinds) != 1:
            p.error("--link needs exactly one of --depends-on OTHER, --blocks OTHER, --relates OTHER")
        if a.title:
            p.error("--link takes the other ticket through its kind flag, not positionally")
        (kind, other), = kinds.items()
        status, out = call("POST", f"/api/tickets/{a.link}/links", {"target": other, "kind": kind})
    elif a.unlink:
        if not a.title:
            p.error("--unlink TICKET needs the other ticket's key or uuid as the positional argument")
        status, out = call("GET", f"/api/tickets/{a.unlink}")
        if status >= 400:
            print(status)
            emit(out)
            return 1
        other = a.title.upper()
        matches = [
            link for link in out.get("links", [])
            if other in (link["ticket"]["key"].upper(), link["ticket"]["id"].upper())
        ]
        if not matches:
            die(f"{out.get('key', a.unlink)} has no link to {a.title}")
        if len(matches) > 1:
            # Two kinds can join the same pair (depends_on plus relates, or
            # both directions of depends_on). Refuse rather than guess.
            found = ", ".join(f"{m['kind']} (link {m['id']})" for m in matches)
            die(f"{out['key']} has more than one link to {a.title}: {found}; remove them in the UI")
        status, out = call("DELETE", f"/api/tickets/{a.unlink}/links/{matches[0]['id']}")
        if status < 400:
            print(status)
            print(f"unlinked {a.unlink} and {a.title}")
            return 0
    elif a.comment:
        # The board's rules tell an agent to comment rather than move a card
        # when there is progress but no state change -- and forbid reaching
        # for curl. Without this the only sanctioned client could not do the
        # one thing those rules ask for most often.
        if a.patch or a.done:
            p.error("--comment adds a comment; it does not also change the ticket")
        if a.repo:
            p.error("--repo applies to filing a new ticket, not to commenting on one")
        if a.title and a.body:
            p.error("give the comment text once, as the positional argument or --body")
        text = a.title or a.body
        if not text:
            p.error("--comment needs the comment text, positionally or via --body")
        status, out = call("POST", f"/api/tickets/{a.comment}/comments", {"body": text})
    elif a.patch or a.done:
        if a.patch and a.done:
            p.error("--patch and --done are alternatives; --done T means --patch T --status done")
        if a.repo:
            p.error("--patch does not move a ticket between repos; --repo applies to filing a new one")
        if a.done and a.evidence is not None:
            handle = a.work_handle or os.environ.get("KANBAN_WORK_HANDLE")
            if not handle:
                die("--done --evidence requires a bound native work session; use the Kanban MCP")
            current = run_kanban_work("lookup", {"handle": handle})
            claim = current["data"].get("active_claim")
            if not isinstance(claim, dict) or str(claim.get("ticket", "")).upper() != a.done.upper():
                die("--done target is not the bound session's current claim; use the Kanban MCP")
            claim_id = claim.get("id")
            if not isinstance(claim_id, str) or not claim_id:
                die("kanban-work returned an invalid active claim")
            completed = run_kanban_work("execute", {
                "handle": handle,
                "operation": "complete_ticket",
                "payload": {
                    "claim_id": claim_id,
                    "evidence": a.evidence,
                    "references": a.reference or [],
                },
            })
            emit(completed["data"])
            return 0
        ticket_id = a.patch or a.done
        fields = {"status": "done"} if a.done else {}
        for name in ("title", "body", "status", "priority", "swimlane"):
            if getattr(a, name) is not None:
                fields[name] = getattr(a, name)
        if a.due is not None:
            # The API clears on an explicit null and ignores an absent field,
            # so the flag needs a spelling for "no due date".
            fields["due_date"] = None if a.due.lower() == "none" else a.due
        if not fields:
            p.error("--patch needs at least one of a new title, --body, --status, --priority, --swimlane or --due")
        status, out = call("PATCH", f"/api/tickets/{ticket_id}", fields)
    else:
        if not a.title:
            p.error("a title is required")
        if not a.repo:
            p.error("--repo is required: every ticket is filed against a named repo")
        here = derive_repo()
        if here is None:
            p.error(
                "this directory is not a checkout with a github.com origin, "
                "so there is no repo to file against"
            )
        if here != a.repo:
            p.error(f"--repo {a.repo} does not match this checkout ({here})")

        ticket = {"title": a.title, "repo": a.repo}
        if a.body:
            ticket["body"] = a.body
        if a.status:
            ticket["status"] = a.status
        if a.swimlane is not None:
            ticket["swimlane"] = a.swimlane
        if a.priority:
            ticket["priority"] = a.priority
        if a.due:
            ticket["due_date"] = a.due

        status, out = call("POST", "/api/tickets", ticket)
        # A repo the board has never seen. Registering it here is safe only
        # because --repo was just proved equal to the remote: the name that
        # gets created is whatever GitHub calls this checkout, never a typo.
        if status == 400 and f"Unknown repo '{a.repo}'" in str(
            out.get("detail", "") if isinstance(out, dict) else out
        ):
            rstatus, rout = call("POST", "/api/repos", {"name": a.repo})
            if rstatus >= 400:
                print(rstatus)
                emit(rout)
                return 1
            print(f"registered repo {a.repo}")
            status, out = call("POST", "/api/tickets", ticket)

    print(status)
    # The issue key is the reference a human will quote, and it is one field
    # in a long JSON body. Surfacing it saves reading the body for it.
    # .get() rather than [] so a board without keys still works.
    if isinstance(out, dict) and out.get("key"):
        print(out["key"])
    emit(out)
    return 0 if status < 400 else 1


if __name__ == "__main__":
    raise SystemExit(main())
