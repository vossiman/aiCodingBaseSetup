#!/usr/bin/env bash
# aicoding-status — detect whether managed tools are behind their main branch and
# print a CTA. CTA-ONLY: never applies an update. Reads/writes a per-tool JSON
# cache; network checks are throttled, timeout-bounded, and fail-open.
set -uo pipefail

# Container-local, NOT ~/.aicodingsetup: that path is a host bind mount shared
# by every devpod container. Sharing this cache (and the manifest below) meant
# one container syncing stamped the global blueprint_commit to the new value,
# so every OTHER container computed installed == latest and went quiet while
# still running stale files — the CTA never fired where it was actually needed.
STATE="${AICODING_UPDATE_STATE:-$HOME/.local/state/aicoding/updates}"
TTL="${AICODING_UPDATE_TTL:-21600}"             # 6h
NET_TIMEOUT="${AICODING_UPDATE_NET_TIMEOUT:-8}"
LOCK="$STATE/.lock"
: "${AICODING_MANIFEST:=$HOME/.local/state/aicoding/manifest.json}"

# Mirror of blueprint-deploy.sh's manifest_adopt_shared. Duplicated rather than
# sourced: this CLI runs on every tmux status-interval and must stay cheap, so
# it does not pull in the full deploy library for six lines.
_adopt_shared_manifest() {
  local shared="$HOME/.aicodingsetup/manifest.json"
  if [ -f "$AICODING_MANIFEST" ] || [ ! -f "$shared" ]; then return 0; fi
  if [ "$shared" = "$AICODING_MANIFEST" ]; then return 0; fi
  mkdir -p "$(dirname "$AICODING_MANIFEST")" 2>/dev/null || return 0
  cp "$shared" "$AICODING_MANIFEST" 2>/dev/null || true
  return 0
}

_installed_aicoding() { _adopt_shared_manifest; jq -r '.blueprint_commit // empty' "$AICODING_MANIFEST" 2>/dev/null; }
_installed_testonly() { tr -d '[:space:]' < "$AICODING_UPDATE_TESTONLY_INSTALLED_FILE" 2>/dev/null; }
_registry() {
  if [ -n "${AICODING_UPDATE_TESTONLY_TOOL:-}" ]; then
    printf '%s|%s|main|_installed_testonly\n' "$AICODING_UPDATE_TESTONLY_TOOL" "$AICODING_UPDATE_TESTONLY_REMOTE"
    return
  fi
  cat <<EOF
aicoding|https://github.com/vossiman/aiCodingBaseSetup|main|_installed_aicoding
EOF
}
_apply_cmd() { case "$1" in aicoding) echo "aicoding-sync";; *) echo "update";; esac; }
_norm() { printf '%.12s' "${1:-}"; }
_now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

_refresh_all() {
  mkdir -p "$STATE"
  local name remote branch ifn installed latest status tmp
  while IFS='|' read -r name remote branch ifn; do
    [ -z "$name" ] && continue
    installed=$("$ifn" 2>/dev/null || true)
    latest=$(timeout "$NET_TIMEOUT" git ls-remote "$remote" "$branch" 2>/dev/null | awk 'NR==1{print $1}')
    # Transient fetch failure (no latest) — keep the prior entry rather than
    # clobbering a known status with "unknown" and hiding the CTA.
    if [ -z "$latest" ] && [ -f "$STATE/$name.json" ]; then
      continue
    fi
    if [ -z "$installed" ] || [ -z "$latest" ]; then status=unknown
    elif [ "$(_norm "$installed")" = "$(_norm "$latest")" ]; then status=up_to_date
    else status=behind; fi
    tmp=$(mktemp "$STATE/.${name}.XXXXXX")
    jq -n --arg t "$name" --arg i "${installed:-}" --arg l "${latest:-}" \
          --arg s "$status" --arg c "$(_now_iso)" --arg a "$(_apply_cmd "$name")" \
      '{tool:$t,installed:$i,latest:$l,status:$s,checked_at:$c,apply_cmd:$a}' > "$tmp"
    mv "$tmp" "$STATE/$name.json"
  done < <(_registry)
}

_cache_fresh() {
  local newest
  newest=$(find "$STATE" -maxdepth 1 -name '*.json' -newermt "-${TTL} seconds" 2>/dev/null | head -1)
  [ -n "$newest" ]
}

_maybe_refresh() {
  mkdir -p "$STATE"
  _cache_fresh && return 0
  if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -newermt "-${TTL} seconds" 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null || true
  fi
  mkdir "$LOCK" 2>/dev/null || return 0
  _refresh_all
  rmdir "$LOCK" 2>/dev/null || true
}

_refresh_detached() { ( _maybe_refresh >/dev/null 2>&1 & ) ; }

_print_banner() {
  local f st tool apply
  for f in "$STATE"/*.json; do
    [ -f "$f" ] || continue
    st=$(jq -r '.status' "$f" 2>/dev/null)
    [ "$st" = "behind" ] || continue
    tool=$(jq -r '.tool' "$f" 2>/dev/null); apply=$(jq -r '.apply_cmd' "$f" 2>/dev/null)
    printf '⬆ %s behind main — run: %s\n' "$tool" "$apply"
  done
}

# --tmux: a compact, no-newline segment for the tmux status line — one `⬆<tool>`
# per behind tool (space-joined), empty when all current/unknown. Like --banner
# it kicks a throttled detached refresh, then only reads the cache, so it stays
# fast enough to run on every tmux status-interval and never blocks the bar.
#
# The segment is APPENDED to status-right, immediately after the clock, so it
# emits its OWN leading gap and divider. They cannot live in tmux.conf: a static
# separator there would render a dangling "│" on every up-to-date container,
# which is most of them most of the time. Styling ships here for the same
# reason — the divider takes the bar's blue and the badge CTA yellow, and only
# this code knows whether anything follows the divider at all.
SEP_STYLE='#[fg=#89b4fa]'   # catppuccin mocha blue — matches the `#H │ %H:%M` divider
CTA_STYLE='#[fg=#f9e2af]'   # catppuccin mocha yellow — reads as a call to action
_print_tmux() {
  local f st tool out=""
  for f in "$STATE"/*.json; do
    [ -f "$f" ] || continue
    st=$(jq -r '.status' "$f" 2>/dev/null)
    [ "$st" = "behind" ] || continue
    tool=$(jq -r '.tool' "$f" 2>/dev/null)
    out="${out:+$out }⬆$tool"
  done
  [ -n "$out" ] && printf ' %s│ %s%s' "$SEP_STYLE" "$CTA_STYLE" "$out"
}

case "${1:-}" in
  --refresh)  _maybe_refresh ;;
  # --banner: kick a throttled refresh in the background and print the CURRENT
  # cache. The first shell after an update may show stale state until the async
  # refresh lands; subsequent shells reflect it. Keeps shell startup non-blocking.
  --banner)   _refresh_detached; _print_banner ;;
  --tmux)     _refresh_detached; _print_tmux ;;
  --print)    _print_banner ;;
  -h|--help)  echo "usage: aicoding-status [--refresh|--banner|--tmux|--print]" ;;
  *)          echo "usage: aicoding-status [--refresh|--banner|--tmux|--print]" >&2; exit 2 ;;
esac
exit 0
