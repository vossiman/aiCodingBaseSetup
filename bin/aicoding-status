#!/usr/bin/env bash
# aicoding-status — detect whether managed tools are behind their main branch and
# print a CTA. CTA-ONLY: never applies an update. Network checks are throttled,
# timeout-bounded, and fail-open.
#
# INVARIANT: the per-tool JSON cache stores ONLY network-derived facts (the
# remote `latest` SHA). The installed commit is read fresh from the manifest at
# print time and compared against the cached latest there. The cache must never
# hold `installed` or a precomputed `status`: a frozen verdict makes every
# manifest writer responsible for invalidating this cache, and that invariant
# failed six times (44a9d42 25deb8f d6ee59b 43795ff 4f621bc 178f776) — new
# writers kept appearing, and self-updating sync executes the previous library,
# so even a fixed writer stamps once with pre-fix code. Do not reintroduce a
# stored verdict.
set -uo pipefail

# Container-local, NOT ~/.aicodingsetup: that path is a host bind mount shared
# by every devpod container. Sharing this cache (and the manifest below) meant
# one container syncing stamped the global blueprint_commit to the new value,
# so every OTHER container computed installed == latest and went quiet while
# still running stale files — the CTA never fired where it was actually needed.
STATE="${AICODING_UPDATE_STATE:-$HOME/.local/state/aicoding/updates}"
TTL="${AICODING_UPDATE_TTL:-21600}"             # 6h
NET_TIMEOUT="${AICODING_UPDATE_NET_TIMEOUT:-8}"
LOCK="$STATE/.lock"
: "${AICODING_MANIFEST:=$HOME/.local/state/aicoding/manifest.json}"

# Mirror of blueprint-deploy.sh's manifest_adopt_shared. Duplicated rather than
# sourced: this CLI runs on every tmux status-interval and must stay cheap, so
# it does not pull in the full deploy library for six lines.
_adopt_shared_manifest() {
  local shared="$HOME/.aicodingsetup/manifest.json"
  if [ -f "$AICODING_MANIFEST" ] || [ ! -f "$shared" ]; then return 0; fi
  if [ "$shared" = "$AICODING_MANIFEST" ]; then return 0; fi
  mkdir -p "$(dirname "$AICODING_MANIFEST")" 2>/dev/null || return 0
  cp "$shared" "$AICODING_MANIFEST" 2>/dev/null || true
  return 0
}

# Installed-fns receive the tool name as $1 (most ignore it).
_installed_aicoding() { _adopt_shared_manifest; jq -r '.blueprint_commit // empty' "$AICODING_MANIFEST" 2>/dev/null; }
# Test seam. AICODING_UPDATE_TESTONLY_TOOL may hold a space-separated list;
# with several tools each reads <INSTALLED_FILE>.<tool>, a single tool reads
# the plain file.
_installed_testonly() {
  local f="$AICODING_UPDATE_TESTONLY_INSTALLED_FILE"
  case "$AICODING_UPDATE_TESTONLY_TOOL" in *' '*) f="$f.$1" ;; esac
  tr -d '[:space:]' < "$f" 2>/dev/null
}
_registry() {
  if [ -n "${AICODING_UPDATE_TESTONLY_TOOL:-}" ]; then
    local t
    for t in $AICODING_UPDATE_TESTONLY_TOOL; do
      printf '%s|%s|main|_installed_testonly\n' "$t" "$AICODING_UPDATE_TESTONLY_REMOTE"
    done
    return
  fi
  cat <<EOF
aicoding|https://github.com/vossiman/aiCodingBaseSetup|main|_installed_aicoding
EOF
}
_apply_cmd() {
  case "$1" in
    aicoding) echo "aicoding-sync";;
    install)  echo "aicoding-install";;
    rebuild)  echo "dvw rebuild ${DEVPOD_WORKSPACE_ID:-<workspace>}";;
    *)        echo "update";;
  esac
}
_badge_label() { case "$1" in aicoding) echo "sync";; *) echo "$1";; esac; }
_norm() { printf '%.12s' "${1:-}"; }
_now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Provision/image staleness: git-history verdicts against the blueprint clone.
# The clone is fetched by _refresh_all (throttled); verdicts run at print time.
# ARRAY, and every expansion below is quoted. As a plain string it went through
# `-- $*`, so bash glob-expanded `lib/provision*` against the CALLER'S cwd
# before git ever saw it: run from an aicoding checkout the pathspec froze to
# the locally-present filenames, and a newly ADDED provisioning lib upstream
# then matched nothing — a silent, cwd-dependent false negative in exactly the
# check this feature exists to provide.
CONTAINER_PROVISION_PATHS=(install.sh 'lib/provision*' image/)
HOST_PROVISION_PATHS=(install-host.sh 'lib/provision*')
_clone_dir() { echo "${AICODING_UPDATE_TESTONLY_CLONE:-${AICODING_BLUEPRINT_CLONE:-/tmp/aicoding}}"; }

_status_profile() {
  local p=${AICODING_PROFILE:-}
  if [ -z "$p" ]; then
    _adopt_shared_manifest
    p=$(jq -r '.profile // "container"' "$AICODING_MANIFEST" 2>/dev/null) || p=container
  fi
  case "$p" in host|container) ;; *) p=container ;; esac
  printf '%s\n' "$p"
}

# _behind_paths <base-sha> <pathspec...> — true when commits after <base-sha>
# on origin/main touch any pathspec. Every guard fails open (return 1 = no badge).
_behind_paths() {
  local base=$1 clone; shift; clone=$(_clone_dir)
  [ -n "$base" ] || return 1
  git -C "$clone" rev-parse --verify -q origin/main >/dev/null 2>&1 || return 1
  git -C "$clone" merge-base --is-ancestor "$base" origin/main 2>/dev/null || return 1
  [ -n "$(git -C "$clone" rev-list "$base"..origin/main -- "$@" 2>/dev/null | head -1)" ]
}

_provision_stamp() { _adopt_shared_manifest; jq -r '.provision_commit // empty' "$AICODING_MANIFEST" 2>/dev/null; }
_image_sha() { jq -r '.sha // empty' "${AICODING_IMAGE_RELEASE_FILE:-/etc/devbox-base-release}" 2>/dev/null; }
_image_built_date() { jq -r '.built // empty' "${AICODING_IMAGE_RELEASE_FILE:-/etc/devbox-base-release}" 2>/dev/null | cut -c1-10; }

# _published_newer — true when the newest published devbox-base date tag
# (cached by _refresh_all) is strictly newer than this image's built date.
# Catches the weekly cron / manual-dispatch publishes that change no image/
# sources. ISO dates compare correctly as strings; fail-open when either
# side is missing.
_published_newer() {
  local newest built
  newest=$(jq -r '.latest_tag // empty' "$STATE/image.json" 2>/dev/null)
  built=$(_image_built_date)
  [ -n "$newest" ] && [ -n "$built" ] && [[ "$newest" > "$built" ]]
}

_behind_extra() {
  if [ "$(_status_profile)" = host ]; then
    _behind_paths "$(_provision_stamp)" "${HOST_PROVISION_PATHS[@]}" && echo install
  else
    _behind_paths "$(_provision_stamp)" "${CONTAINER_PROVISION_PATHS[@]}" && echo install
    { _behind_paths "$(_image_sha)" image/ || _published_newer; } && echo rebuild
  fi
  return 0
}

# Fetch each tool's remote latest and cache it — nothing else (see the header
# invariant). The installed side is deliberately NOT read here.
_refresh_all() {
  mkdir -p "$STATE"
  local name remote branch ifn latest tmp
  while IFS='|' read -r name remote branch ifn; do
    [ -z "$name" ] && continue
    latest=$(timeout "$NET_TIMEOUT" git ls-remote "$remote" "$branch" 2>/dev/null | awk 'NR==1{print $1}')
    # Transient fetch failure — keep the prior known latest rather than
    # clobbering it and hiding the CTA.
    if [ -z "$latest" ] && [ -f "$STATE/$name.json" ]; then
      continue
    fi
    # Cold cache + failure still writes (empty latest → no badge): the fresh
    # file makes _cache_fresh throttle retries instead of hammering the remote.
    tmp=$(mktemp "$STATE/.${name}.XXXXXX")
    jq -n --arg t "$name" --arg l "${latest:-}" \
          --arg c "$(_now_iso)" --arg a "$(_apply_cmd "$name")" \
      '{tool:$t,latest:$l,checked_at:$c,apply_cmd:$a}' > "$tmp"
    mv "$tmp" "$STATE/$name.json"
  done < <(_registry)

  # Repo rule (CLAUDE.md): gate every network call behind
  # AICODINGSETUP_SKIP_NETWORK. Without it the bats suite — which stubs only
  # ls-remote — would fetch github.com for real AND mutate the live
  # /tmp/aicoding clone that exists in every devbox.
  local clone; clone=$(_clone_dir)
  if [ -z "${AICODINGSETUP_SKIP_NETWORK:-}" ] && [ -d "$clone/.git" ]; then
    timeout "$NET_TIMEOUT" git -C "$clone" fetch -q origin main 2>/dev/null || true
  fi

  # Newest published devbox-base date tag — a network fact, cached like the
  # ls-remote SHAs (never a verdict). ghcr allows anonymous pull-scope tokens
  # for this public image, so no credentials are involved; both calls are
  # timeout-bounded and gated per the repo network rule. Only a non-empty
  # result writes, so transient failures keep the prior known tag.
  if [ -z "${AICODINGSETUP_SKIP_NETWORK:-}" ] && [ "$(_status_profile)" != host ]; then
    local ghcr_repo="${AICODING_IMAGE_GHCR_REPO:-vossiman/devbox-base}" tok newest
    tok=$(timeout "$NET_TIMEOUT" curl -fsSL \
      "https://ghcr.io/token?scope=repository:${ghcr_repo}:pull&service=ghcr.io" 2>/dev/null \
      | jq -r '.token // empty' 2>/dev/null)
    if [ -n "$tok" ]; then
      newest=$(timeout "$NET_TIMEOUT" curl -fsSL -H "Authorization: Bearer $tok" \
        "https://ghcr.io/v2/${ghcr_repo}/tags/list" 2>/dev/null \
        | jq -r '.tags[]? // empty' 2>/dev/null \
        | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' | sort | tail -1)
      if [ -n "$newest" ]; then
        tmp=$(mktemp "$STATE/.image.XXXXXX")
        jq -n --arg t "$newest" --arg c "$(_now_iso)" \
          '{latest_tag:$t,checked_at:$c}' > "$tmp"
        mv "$tmp" "$STATE/image.json"
      fi
    fi
  fi
}

_cache_fresh() {
  local newest
  newest=$(find "$STATE" -maxdepth 1 -name '*.json' -newermt "-${TTL} seconds" 2>/dev/null | head -1)
  [ -n "$newest" ]
}

_maybe_refresh() {
  mkdir -p "$STATE"
  _cache_fresh && return 0
  if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -newermt "-${TTL} seconds" 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null || true
  fi
  mkdir "$LOCK" 2>/dev/null || return 0
  _refresh_all
  rmdir "$LOCK" 2>/dev/null || true
}

# AICODING_UPDATE_TESTONLY_NO_DETACH: test seam. The forked child does
# `mkdir -p "$STATE"` under the test's $TMP, which raced bats teardown's
# `rm -rf "$TMP"` ("Directory not empty") and failed tests at random.
_refresh_detached() {
  [ -n "${AICODING_UPDATE_TESTONLY_NO_DETACH:-}" ] && return 0
  ( _maybe_refresh >/dev/null 2>&1 & )
  return 0
}

# _behind_tools — one behind tool name per line, registry order. The verdict is
# computed HERE, at print time: cached latest vs a fresh installed read. No
# network; either side missing/empty → no badge for that tool (fail-open). This
# is what lets a stuck badge self-heal on the next tick after any manifest
# write, whether or not the writer invalidated the cache.
_behind_tools() {
  local name remote branch ifn latest installed
  while IFS='|' read -r name remote branch ifn; do
    [ -z "$name" ] && continue
    [ -f "$STATE/$name.json" ] || continue
    latest=$(jq -r '.latest // empty' "$STATE/$name.json" 2>/dev/null)
    [ -n "$latest" ] || continue
    installed=$("$ifn" "$name" 2>/dev/null)
    [ -n "$installed" ] || continue
    [ "$(_norm "$installed")" = "$(_norm "$latest")" ] && continue
    printf '%s\n' "$name"
  done < <(_registry)
}

_print_banner() {
  local tool
  while read -r tool; do
    [ -n "$tool" ] || continue
    case "$tool" in
      install) printf '⬆ provisioning behind blueprint — run: %s\n' "$(_apply_cmd "$tool")" ;;
      rebuild) printf '⬆ image outdated — from your laptop: %s\n' "$(_apply_cmd "$tool")" ;;
      *)       printf '⬆ %s behind main — run: %s\n' "$tool" "$(_apply_cmd "$tool")" ;;
    esac
  done < <({ _behind_tools; _behind_extra; })
}

# --tmux: a compact, no-newline segment for the tmux status line — one `⬆<tool>`
# per behind tool (space-joined), empty when all current/unknown. Like --banner
# it kicks a throttled detached refresh, then reads only the cache and the
# local manifest — no network — so it stays fast enough to run on every tmux
# status-interval and never blocks the bar.
#
# The segment is APPENDED to status-right, immediately after the clock, so it
# emits its OWN leading gap and divider. They cannot live in tmux.conf: a static
# separator there would render a dangling "│" on every up-to-date container,
# which is most of them most of the time. Styling ships here for the same
# reason — the divider takes the bar's blue and the badge CTA yellow, and only
# this code knows whether anything follows the divider at all.
SEP_STYLE='#[fg=#89b4fa]'   # catppuccin mocha blue — matches the `#H │ %H:%M` divider
CTA_STYLE='#[fg=#f9e2af]'   # catppuccin mocha yellow — reads as a call to action
_print_tmux() {
  local tool out=""
  while read -r tool; do
    [ -n "$tool" ] || continue
    out="${out:+$out }⬆$(_badge_label "$tool")"
  done < <({ _behind_tools; _behind_extra; })
  [ -n "$out" ] && printf ' %s│ %s%s' "$SEP_STYLE" "$CTA_STYLE" "$out"
}

case "${1:-}" in
  --refresh)  _maybe_refresh ;;
  # --refresh-attach: tmux client-attached hook. Force a check past the idle
  # TTL, but keep a short min-interval so reconnect storms (5 attaches in 4
  # minutes, 2026-08-08) cost one network call, not five. Foreground here;
  # the tmux hook backgrounds it with run-shell -b.
  --refresh-attach) TTL="${AICODING_UPDATE_ATTACH_MIN:-300}" _maybe_refresh ;;
  # --banner: kick a throttled refresh in the background and print the CURRENT
  # cache. The first shell after an update may show stale state until the async
  # refresh lands; subsequent shells reflect it. Keeps shell startup non-blocking.
  --banner)   _refresh_detached; _print_banner ;;
  --tmux)     _refresh_detached; _print_tmux ;;
  --print)    _print_banner ;;
  -h|--help)  echo "usage: aicoding-status [--refresh|--banner|--tmux|--print]" ;;
  *)          echo "usage: aicoding-status [--refresh|--banner|--tmux|--print]" >&2; exit 2 ;;
esac
exit 0
