#!/usr/bin/env bash
set -uo pipefail
SCRIPT_REAL=$(readlink -f "$0"); SCRIPT_DIR=$(dirname "$(dirname "$SCRIPT_REAL")")
: "${AICODING_BLUEPRINT_CLONE:=/tmp/aicoding}"
# NO AICODING_MANIFEST default here. lib/blueprint-deploy.sh owns it, and it is
# sourced (lib/sync.sh:179) before the first use (lib/sync.sh:182). A duplicate
# default here silently won — `:=` in the library is a no-op once this set it —
# so sync wrote the old shared ~/.aicodingsetup manifest while aicoding-status
# read the container-local one. They never agreed again, and the update badge
# stayed lit no matter how often you synced.
. "$SCRIPT_DIR/lib/blueprint-source.sh"
aicoding_parse_blueprint_args aicoding-sync "$@" || exit $?
for arg in "${AICODING_REMAINING_ARGS[@]}"; do
  case "$arg" in
    -h|--help)
      echo "usage: aicoding-sync [--blueprint PATH] [--dry-run|--yes|--boot|--first]"
      echo "  --blueprint PATH  use this local Git checkout verbatim (never fetch or reset it)"
      exit 0
      ;;
  esac
done
# Prefer the refreshed blueprint clone if present; else the install dir.
[ -f "$AICODING_BLUEPRINT_CLONE/lib/sync.sh" ] && . "$AICODING_BLUEPRINT_CLONE/lib/sync.sh" \
  || . "$SCRIPT_DIR/lib/sync.sh"
aicoding_sync "${AICODING_REMAINING_ARGS[@]}"
