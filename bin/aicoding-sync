#!/usr/bin/env bash
set -uo pipefail
SCRIPT_REAL=$(readlink -f "$0"); SCRIPT_DIR=$(dirname "$(dirname "$SCRIPT_REAL")")

# The scheduled entrypoint is incapable of prompting, including in code
# reached after a refresh exec.
for _aicoding_arg in "$@"; do
  [ "$_aicoding_arg" = --boot ] && { exec </dev/null; break; }
done
unset _aicoding_arg

# Serialize the entire run before loading a possibly stale tracking clone. The
# descriptor and owner PID survive refresh's exec; a separately forked command
# gets a new PID and must contend for the lock normally.
: "${AICODING_STATE_DIR:=$HOME/.local/state/aicoding}"
mkdir -p "$AICODING_STATE_DIR"
if [ "${AICODING_SYNC_LOCK_PID:-}" != "$$" ] || [ -z "${AICODING_SYNC_LOCK_FD:-}" ]; then
  if [ -n "${AICODING_SYNC_LOCK_FD:-}" ]; then exec {AICODING_SYNC_LOCK_FD}>&- 2>/dev/null || true; fi
  exec {AICODING_SYNC_LOCK_FD}>"$AICODING_STATE_DIR/sync.lock" || exit 1
  if ! flock -n "$AICODING_SYNC_LOCK_FD"; then
    echo "aicoding-sync: update already running" >&2
    exit 0
  fi
  export AICODING_SYNC_LOCK_FD AICODING_SYNC_LOCK_PID=$$
fi
# NO AICODING_MANIFEST default here. lib/sync.sh and blueprint-deploy.sh share
# the canonical container-local default. A duplicate entrypoint default once
# silently won — `:=` in the libraries became a no-op — so sync wrote the old
# shared ~/.aicodingsetup manifest while aicoding-status read the local one.
. "$SCRIPT_DIR/lib/blueprint-source.sh"
AICODING_BLUEPRINT_LOCAL=0
aicoding_parse_blueprint_args aicoding-sync "$@" || exit $?
if [ "$AICODING_BLUEPRINT_LOCAL" != 1 ]; then
  # A stable launcher has already resolved this immutable physical release.
  # Ignore inherited legacy tracking-clone variables; only --blueprint may
  # choose executable source outside this release.
  AICODING_BLUEPRINT_CLONE=$SCRIPT_DIR
  export AICODING_BLUEPRINT_CLONE
fi
for arg in "${AICODING_REMAINING_ARGS[@]}"; do
  case "$arg" in
    -h|--help)
      echo "usage: aicoding-sync [--blueprint PATH] [--dry-run|--yes|--boot|--first]"
      echo "  --blueprint PATH  use this local Git checkout verbatim (never fetch or reset it)"
      echo "                    use the same checkout clean at origin/main to return to origin/main tracking"
      exit 0
      ;;
  esac
done
. "$AICODING_BLUEPRINT_CLONE/lib/sync.sh"
aicoding_sync "${AICODING_REMAINING_ARGS[@]}"
_aicoding_sync_rc=$?
# Existing fallback shells retain old library code after runtime activation.
# Their first pass through this selected entrypoint queues a safe idle upgrade.
if [ "$AICODING_BLUEPRINT_LOCAL" != 1 ] && [ -z "${AICODINGSETUP_SKIP_NETWORK:-}" ]; then
  for arg in "${AICODING_REMAINING_ARGS[@]}"; do
    if [ "$arg" = --boot ] && [ -f "$SCRIPT_DIR/lib/auto-update.sh" ]; then
      . "$SCRIPT_DIR/lib/auto-update.sh"
      aicoding_auto_upgrade_worker_after_sync "$SCRIPT_DIR" || true
      break
    fi
  done
fi
exit "$_aicoding_sync_rc"
