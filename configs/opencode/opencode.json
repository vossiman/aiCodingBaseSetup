{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": [
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "{{FIRECRAWL_API_KEY}}"
      },
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "brave-search-mcp-server"
      ],
      "environment": {
        "BRAVE_API_KEY": "{{BRAVE_API_KEY}}"
      },
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ],
      "enabled": true
    },
    "memory-router": {
      "type": "remote",
      "url": "http://10.0.0.249:8091/mcp",
      "headers": {
        "Authorization": "Bearer {{MEMORY_ROUTER_TOKEN}}"
      },
      "oauth": false,
      "enabled": true
    }
  },
  "agent": {},
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "**/.aicodingsetup/**": "deny",
      "**/.aicodingsetup/.secrets.env": "deny",
      "**/.aicodingsetup/*-ship": "deny",
      "**/.secrets.env": "deny",
      "**/*.secrets.env": "deny",
      "**/secrets.env": "deny",
      "**/.env.secrets": "deny",
      "**/.ssh/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/.netrc": "deny",
      "**/.pgpass": "deny",
      "**/.config/gh/**": "deny",
      "**/.claude.json": "deny",
      "**/.codex/config.toml": "deny",
      "**/.config/opencode/opencode.json": "deny",
      "**/.cursor/mcp.json": "deny"
    },
    "bash": {
      "*": "allow",
      "*secrets.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*id_rsa*": "deny",
      "*id_dsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "*.aicodingsetup*": "deny",
      "*gh auth token*": "deny",
      "*git credential*": "deny",
      "*git-credential-*": "deny",
      "*declare -p *TOKEN*": "deny",
      "*declare -p *KEY*": "deny",
      "*declare -p *SECRET*": "deny",
      "*declare -p *PASSWORD*": "deny",
      "*typeset -p *TOKEN*": "deny",
      "*typeset -p *SECRET*": "deny",
      "*printenv*TOKEN*": "deny",
      "*printenv*KEY*": "deny",
      "*printenv*SECRET*": "deny",
      "*printenv*PASSWORD*": "deny",
      "*environ*": "deny"
    }
  }
}
