{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 20000
  },
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": [
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "{{FIRECRAWL_API_KEY}}"
      },
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "brave-search-mcp-server"
      ],
      "environment": {
        "BRAVE_API_KEY": "{{BRAVE_API_KEY}}"
      },
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--browser",
        "chromium"
      ],
      "enabled": true
    },
    "kanban": {
      "type": "remote",
      "url": "https://kanban.dataprospectors.at/mcp",
      "headers": {
        "Authorization": "Bearer {{KANBAN_TOKEN}}"
      },
      "oauth": false,
      "enabled": true
    },
    "memory-router": {
      "type": "remote",
      "url": "http://10.0.0.249:8091/mcp",
      "headers": {
        "Authorization": "Bearer {{MEMORY_ROUTER_TOKEN}}"
      },
      "oauth": false,
      "enabled": true
    }
  },
  "agent": {},
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "**/.aicodingsetup/**": "deny",
      "**/.aicodingsetup/.secrets.env": "deny",
      "**/.aicodingsetup/*-ship": "deny",
      "**/.secrets.env": "deny",
      "**/*.secrets.env": "deny",
      "**/secrets.env": "deny",
      "**/.env.secrets": "deny",
      "**/.ssh/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/.netrc": "deny",
      "**/.pgpass": "deny",
      "**/.config/gh/**": "deny",
      "**/.claude.json": "deny",
      "**/.codex/config.toml": "deny",
      "**/.codex/.aicoding-sync": "deny",
      "**/.codex/.aicoding-sync/**": "deny",
      "**/.config/opencode/opencode.json": "deny",
      "**/.cursor/mcp.json": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "env>*": "deny",
      "env >*": "deny",
      "env |*": "deny",
      "env *>*": "deny",
      "env *|*": "deny",
      "/usr/bin/env": "deny",
      "/usr/bin/env>*": "deny",
      "/usr/bin/env >*": "deny",
      "/usr/bin/env |*": "deny",
      "/usr/bin/env *>*": "deny",
      "/usr/bin/env *|*": "deny",
      "printenv": "deny",
      "printenv>*": "deny",
      "printenv >*": "deny",
      "printenv |*": "deny",
      "printenv *>*": "deny",
      "printenv *|*": "deny",
      "set": "deny",
      "set>*": "deny",
      "set >*": "deny",
      "set |*": "deny",
      "set *>*": "deny",
      "set *|*": "deny",
      "export": "deny",
      "export>*": "deny",
      "export >*": "deny",
      "export |*": "deny",
      "export *>*": "deny",
      "export *|*": "deny",
      "declare": "deny",
      "declare>*": "deny",
      "declare >*": "deny",
      "declare |*": "deny",
      "declare *>*": "deny",
      "declare *|*": "deny",
      "typeset": "deny",
      "typeset>*": "deny",
      "typeset >*": "deny",
      "typeset |*": "deny",
      "typeset *>*": "deny",
      "typeset *|*": "deny",
      "*secrets.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*id_rsa*": "deny",
      "*id_dsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "*.aicodingsetup*": "deny",
      "*gh auth token*": "deny",
      "*git credential*": "deny",
      "*git-credential-*": "deny",
      "*declare -p *TOKEN*": "deny",
      "*declare -p *KEY*": "deny",
      "*declare -p *SECRET*": "deny",
      "*declare -p *PASSWORD*": "deny",
      "*typeset -p *TOKEN*": "deny",
      "*typeset -p *SECRET*": "deny",
      "*printenv*TOKEN*": "deny",
      "*printenv*KEY*": "deny",
      "*printenv*SECRET*": "deny",
      "*printenv*PASSWORD*": "deny",
      "*environ*": "deny",
      "*.p12*": "deny",
      "*.pfx*": "deny",
      "*typeset -p *KEY*": "deny",
      "*typeset -p *PASSWORD*": "deny",
      "kill *": "deny",
      "/bin/kill *": "deny",
      "/usr/bin/kill *": "deny",
      "pkill *": "deny",
      "/bin/pkill *": "deny",
      "/usr/bin/pkill *": "deny",
      "killall *": "deny",
      "/bin/killall *": "deny",
      "/usr/bin/killall *": "deny",
      "killall5 *": "deny",
      "/bin/killall5 *": "deny",
      "/usr/bin/killall5 *": "deny",
      "skill *": "deny",
      "/bin/skill *": "deny",
      "/usr/bin/skill *": "deny",
      "snice *": "deny",
      "/bin/snice *": "deny",
      "/usr/bin/snice *": "deny",
      "tkill *": "deny",
      "/bin/tkill *": "deny",
      "/usr/bin/tkill *": "deny",
      "xkill *": "deny",
      "/bin/xkill *": "deny",
      "/usr/bin/xkill *": "deny",
      "fkill *": "deny",
      "/bin/fkill *": "deny",
      "/usr/bin/fkill *": "deny",
      "sudo kill *": "deny",
      "sudo pkill *": "deny",
      "sudo killall *": "deny",
      "doas kill *": "deny",
      "doas pkill *": "deny",
      "doas killall *": "deny",
      "env kill *": "deny",
      "env pkill *": "deny",
      "env killall *": "deny",
      "command kill *": "deny",
      "command pkill *": "deny",
      "command killall *": "deny",
      "builtin kill *": "deny",
      "builtin pkill *": "deny",
      "builtin killall *": "deny",
      "exec kill *": "deny",
      "exec pkill *": "deny",
      "exec killall *": "deny",
      "nohup kill *": "deny",
      "nohup pkill *": "deny",
      "nohup killall *": "deny",
      "setsid kill *": "deny",
      "setsid pkill *": "deny",
      "setsid killall *": "deny",
      "busybox kill *": "deny",
      "busybox pkill *": "deny",
      "busybox killall *": "deny",
      "xargs kill *": "deny",
      "xargs pkill *": "deny",
      "xargs killall *": "deny",
      "reboot *": "deny",
      "poweroff *": "deny",
      "halt *": "deny",
      "shutdown *": "deny",
      "kill-port *": "deny",
      "npx kill-port *": "deny",
      "fuser *-*k*": "deny",
      "systemctl *stop *": "deny",
      "systemctl *kill *": "deny",
      "systemctl *restart *": "deny",
      "systemctl *isolate *": "deny",
      "systemctl *reboot *": "deny",
      "systemctl *poweroff *": "deny",
      "systemctl *halt *": "deny",
      "systemctl *kexec *": "deny",
      "systemctl *emergency *": "deny",
      "systemctl *rescue *": "deny",
      "systemctl *suspend *": "deny",
      "systemctl *hibernate *": "deny",
      "systemctl *hybrid-sleep *": "deny",
      "loginctl *terminate-*": "deny",
      "loginctl *kill-*": "deny",
      "tmux *kill-*": "deny"
    }
  }
}
