{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(find:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.secrets.env)",
      "Read(**/.env.secrets)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.secrets.env)",
      "Read(~/.aicodingsetup/*-ship)",
      "Read(~/.aicodingsetup/.secrets.env)",
      "Read(~/.claude.json)",
      "Read(~/.codex/config.toml)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/opencode/opencode.json)",
      "Read(~/.cursor/mcp.json)",
      "Read(~/.ssh/id_*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "0"
  },
  "effortLevel": "medium",
  "outputStyle": "Concise",
  "autoMemoryEnabled": false,
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/bw-deny-files.sh\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude Stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/llmwiki-distill.sh\"",
            "async": true,
            "timeout": 600
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/redact-sessions-hook.sh\"",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/agent-waiting.sh\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/check-archived-docs.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude SessionStart",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/redact-sessions-pending.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude UserPromptSubmit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/agent-working.sh\"",
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/memory-hint.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/opus-verbosity.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/fable-guidance.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude SessionEnd",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/redact-sessions-hook.sh\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude StopFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{HOME}}/.claude/hooks/kanban-work-hook.sh\" claude SubagentStop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"{{HOME}}/.claude/hooks/custom-statusline.js\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": false
  }
}
