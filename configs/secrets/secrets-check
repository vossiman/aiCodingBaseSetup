#!/usr/bin/env bash
# secrets-check — report which secrets are configured, WITHOUT printing values.
#
# Managed by the aiCodingBaseSetup blueprint (configs/secrets/secrets-check);
# aicoding-sync overwrites local edits — change it there, via PR.
#
# This is the sanctioned escape hatch for the bw-deny-files.sh PreToolUse hook
# (and the equivalent deny rules in the codex/cursor/opencode configs), which
# block agents from reading ~/.aicodingsetup/.secrets.env directly. Agents can
# still answer "is GH_TOKEN set?" — they just cannot see the token.
#
# Each key is reported as: name, status, value length, and a short salted
# fingerprint. The fingerprint is stable on one machine, so two machines can be
# compared for "same value or not" without either revealing it.
#
# Usage:
#   secrets-check              # table for every key in the secrets file
#   secrets-check GH_TOKEN     # just these keys (exit 1 if any is unset/empty)
#   secrets-check --env        # also check the live environment, not the file

set -euo pipefail

SECRETS_FILE="${AICODING_SECRETS_FILE:-$HOME/.aicodingsetup/.secrets.env}"
CHECK_ENV=false
WANTED=()

for arg in "$@"; do
  case "$arg" in
    --env) CHECK_ENV=true ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "secrets-check: unknown option '$arg'" >&2; exit 2 ;;
    *) WANTED+=("$arg") ;;
  esac
done

# Fingerprint: salted so the digest is useless to anyone who does not already
# hold the machine's salt, but stable across runs on this machine.
FP_SALT_FILE="$HOME/.local/state/aicoding/secrets-check.salt"
fingerprint() {
  local value="$1" salt=""
  if [[ -r "$FP_SALT_FILE" ]]; then
    salt="$(cat "$FP_SALT_FILE")"
  else
    mkdir -p "$(dirname "$FP_SALT_FILE")"
    salt="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    printf '%s' "$salt" > "$FP_SALT_FILE"
    chmod 600 "$FP_SALT_FILE"
  fi
  printf '%s%s' "$salt" "$value" | sha256sum | cut -c1-8
}

if [[ ! -r "$SECRETS_FILE" ]]; then
  echo "secrets-check: $SECRETS_FILE not readable (missing, or not mounted)" >&2
  [[ "$CHECK_ENV" == false ]] && exit 1
fi

# Parse KEY=VALUE without sourcing the file (sourcing would run arbitrary code
# and, more importantly, leak values into this process's environment).
declare -a KEYS=()
declare -A VALUES=()
if [[ -r "$SECRETS_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"          # ltrim
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" != *=* ]] && continue
    local_key="${line%%=*}"
    local_key="${local_key#export }"
    local_key="${local_key//[[:space:]]/}"
    [[ "$local_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    local_val="${line#*=}"
    local_val="${local_val#\"}"; local_val="${local_val%\"}"
    local_val="${local_val#\'}"; local_val="${local_val%\'}"
    KEYS+=("$local_key")
    VALUES["$local_key"]="$local_val"
  done < "$SECRETS_FILE"
fi

if (( ${#WANTED[@]} > 0 )); then
  KEYS=("${WANTED[@]}")
fi

printf '%-28s %-9s %6s  %s\n' "KEY" "STATUS" "LEN" "FINGERPRINT"
printf '%-28s %-9s %6s  %s\n' "---" "------" "---" "-----------"

rc=0
for key in "${KEYS[@]}"; do
  value="${VALUES[$key]-}"
  source_note=""
  if [[ -z "$value" && "$CHECK_ENV" == true ]]; then
    value="${!key-}"
    [[ -n "$value" ]] && source_note=" (env only, not in file)"
  fi

  if [[ -z "$value" ]]; then
    printf '%-28s %-9s %6s  %s\n' "$key" "EMPTY" "0" "-"
    rc=1
  else
    printf '%-28s %-9s %6s  %s%s\n' "$key" "set" "${#value}" "$(fingerprint "$value")" "$source_note"
  fi
done

echo
echo "Values are never printed. Fingerprints are salted per machine — equal"
echo "fingerprints on two machines mean equal values; they reveal nothing else."
exit "$rc"
