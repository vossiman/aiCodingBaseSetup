{
  "mixed": {
    ".claude/settings.json": {
      "source": "configs/claude/settings.json",
      "owned": ["hooks.*", "statusLine", "env.*", "enabledPlugins.*", "permissions.deny[]", "permissions.allow[]"],
      "seeded": ["effortLevel", "outputStyle", "autoMemoryEnabled", "crossSessionInbound", "isolatePeerMachines", "skipDangerousModePermissionPrompt"]
    },
    ".cursor/mcp.json": {
      "source": "configs/cursor/mcp.json",
      "owned": ["mcpServers.*"],
      "seeded": []
    },
    ".cursor/cli-config.json": {
      "source": "configs/cursor/cli-config.json",
      "owned": ["permissions.deny[]", "statusLine"],
      "seeded": ["approvalMode", "autoAcceptWebSearch"]
    },
    ".config/opencode/opencode.json": {
      "source": "configs/opencode/opencode.json",
      "owned": ["$schema", "mcp.*", "command.*", "permission"],
      "seeded": ["model", "provider", "provider.openai.models.*", "compaction", "agent"]
    },
    ".codex/config.toml": {
      "source": "configs/codex/config.toml",
      "owned": ["notify", "approval_policy", "sandbox_mode", "mcp_servers.*", "features.*"],
      "seeded": ["model", "model_context_window", "model_auto_compact_token_limit", "tui.*"]
    }
  },
  "retired_files": [
    {"dest": ".claude/commands/scaffold-project.md", "source": "commands/scaffold-project.md"},
    {"dest": ".claude/commands/housekeep.md", "source": "commands/housekeep.md"},
    {"dest": ".claude/commands/wrapup.md", "source": "commands/wrapup.md"},
    {"dest": ".claude/hooks/llmwiki-nudge.sh", "source": "configs/claude/hooks/llmwiki-nudge.sh"},
    {"dest": ".claude/skills/dataprospectors-design/assets/dp-logo.svg", "source": "skills/dataprospectors-design/assets/dp-logo.svg"},
    {"dest": ".claude/skills/dataprospectors-design/assets/dp-logo-dark.svg", "source": "skills/dataprospectors-design/assets/dp-logo-dark.svg"},
    {"dest": ".claude/skills/logfire/SKILL.md", "source": "skills/logfire/SKILL.md"},
    {"dest": ".aicodingsetup/templates/paseo-config.json", "source": "configs/paseo/config.json"}
  ],
  "retired_keys": [
    {"dest": ".claude/settings.json", "path": ["enabledPlugins", "skill-creator@claude-plugins-official"], "shipped": [true]},
    {"dest": ".claude/settings.json", "path": ["enabledPlugins", "code-review@claude-plugins-official"], "shipped": [true]},
    {"dest": ".config/opencode/opencode.json", "path": ["command", "wrapup"], "shipped": [{"description": "Check that closing this session and rolling into a new one loses nothing, then give a close verdict.", "template": "Read `~/.claude/skills/wrapup/SKILL.md` and follow it for this session."}, {"description": "Check that this session's work, tickets, git state and cleanup are finished, then give a close verdict.", "template": "Read `~/.claude/skills/wrapup/SKILL.md` and follow it for this session."}]},
    {"dest": ".cursor/mcp.json", "path": ["mcpServers", "kanban"], "shipped": [{"command": "kanban-mcp"}]},
    {"dest": ".config/opencode/opencode.json", "path": ["mcp", "kanban"], "shipped": [{"type": "local", "command": ["kanban-mcp"], "enabled": true}]},
    {"dest": ".codex/config.toml", "path": ["mcp_servers", "kanban"], "shipped": [{"command": "kanban-mcp"}, {"command": "kanban-mcp", "required": true, "startup_timeout_sec": 30}]}
  ]
}
