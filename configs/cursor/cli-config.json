{
  "permissions": {
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.secrets.env)",
      "Read(**/.aicodingsetup/**)",
      "Read(**/.claude.json)",
      "Read(**/.codex/.aicoding-sync)",
      "Read(**/.codex/.aicoding-sync/**)",
      "Read(**/.codex/config.toml)",
      "Read(**/.config/gh/**)",
      "Read(**/.config/opencode/opencode.json)",
      "Read(**/.cursor/mcp.json)",
      "Read(**/.env.secrets)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.secrets.env)",
      "Read(**/.ssh/**)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/secrets.env)",
      "Shell(/bin/kill)",
      "Shell(/bin/killall)",
      "Shell(/bin/pkill)",
      "Shell(/usr/bin/kill)",
      "Shell(/usr/bin/killall)",
      "Shell(/usr/bin/pkill)",
      "Shell(bash:*-*c*kill*)",
      "Shell(builtin:*kill*)",
      "Shell(busybox:*kill*)",
      "Shell(command:*kill*)",
      "Shell(dash:*-*c*kill*)",
      "Shell(declare)",
      "Shell(doas:*kill*)",
      "Shell(env)",
      "Shell(env:*kill*)",
      "Shell(eval:*kill*)",
      "Shell(exec:*kill*)",
      "Shell(export)",
      "Shell(fkill)",
      "Shell(fuser:*-*k*)",
      "Shell(halt)",
      "Shell(kill)",
      "Shell(kill-port)",
      "Shell(killall)",
      "Shell(killall5)",
      "Shell(loginctl:*kill-*)",
      "Shell(loginctl:*terminate-*)",
      "Shell(nohup:*kill*)",
      "Shell(npx:*kill*)",
      "Shell(pkill)",
      "Shell(poweroff)",
      "Shell(printenv)",
      "Shell(reboot)",
      "Shell(set)",
      "Shell(setsid:*kill*)",
      "Shell(sh:*-*c*kill*)",
      "Shell(shutdown)",
      "Shell(skill)",
      "Shell(snice)",
      "Shell(sudo:*kill*)",
      "Shell(systemctl:*emergency*)",
      "Shell(systemctl:*halt*)",
      "Shell(systemctl:*hibernate*)",
      "Shell(systemctl:*hybrid-sleep*)",
      "Shell(systemctl:*isolate*)",
      "Shell(systemctl:*kexec*)",
      "Shell(systemctl:*kill*)",
      "Shell(systemctl:*poweroff*)",
      "Shell(systemctl:*reboot*)",
      "Shell(systemctl:*rescue*)",
      "Shell(systemctl:*restart*)",
      "Shell(systemctl:*stop*)",
      "Shell(systemctl:*suspend*)",
      "Shell(timeout:*kill*)",
      "Shell(tkill)",
      "Shell(tmux:*kill-*)",
      "Shell(typeset)",
      "Shell(xargs:*kill*)",
      "Shell(xkill)",
      "Shell(zsh:*-*c*kill*)",
      "Write(**/.aicodingsetup/**)",
      "Write(**/.config/gh/**)"
    ]
  },
  "approvalMode": "unrestricted",
  "autoAcceptWebSearch": true,
  "statusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/hooks/custom-statusline.js"
  }
}
