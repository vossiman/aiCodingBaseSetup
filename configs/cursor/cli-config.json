{
  "permissions": {
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.secrets.env)",
      "Read(**/.aicodingsetup/**)",
      "Read(**/.claude.json)",
      "Read(**/.codex/config.toml)",
      "Read(**/.config/gh/**)",
      "Read(**/.config/opencode/opencode.json)",
      "Read(**/.cursor/mcp.json)",
      "Read(**/.env.secrets)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.secrets.env)",
      "Read(**/.ssh/**)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/secrets.env)",
      "Shell(declare)",
      "Shell(env)",
      "Shell(export)",
      "Shell(printenv)",
      "Shell(set)",
      "Shell(typeset)",
      "Write(**/.aicodingsetup/**)",
      "Write(**/.config/gh/**)"
    ]
  },
  "approvalMode": "unrestricted",
  "autoAcceptWebSearch": true,
  "statusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/hooks/custom-statusline.js"
  }
}
