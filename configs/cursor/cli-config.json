{
  "permissions": {
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.aicodingsetup/**)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.secrets.env)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Write(**/.aicodingsetup/**)"
    ]
  },
  "approvalMode": "unrestricted",
  "autoAcceptWebSearch": true,
  "statusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/hooks/custom-statusline.js"
  }
}
