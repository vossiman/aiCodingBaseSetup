[Unit]
Description=Check for CI-qualified aicoding updates every six hours

[Timer]
OnBootSec=2min
# Wall-clock schedule: monotonic timers pause during suspend, so a sleeping
# laptop would skip due passes. Persistent catches up on resume or boot.
OnCalendar=*-*-* 00/6:00:00
Persistent=true
RandomizedDelaySec=10min
Unit=aicoding-auto-update.service

[Install]
WantedBy=timers.target
