#!/usr/bin/env python3
"""memory-hint - tier-1 automatic memory check (agent-agnostic).

Reads a user prompt on stdin, asks the memory-lanes router's /hint endpoint
for champion matches, and prints a <memory-hints> block for injection into
agent context. Prints nothing and exits 0 on ANY failure or weak input: this
must never block or break an agent turn. Adapters (Claude Code hook, Codex
hook, OpenCode plugin, ...) differ only in how they extract the prompt and
where they put the stdout.
"""
import argparse
import json
import os
import re
import sys
import urllib.parse
import urllib.request

SECRETS = os.path.expanduser("~/.aicodingsetup/.secrets.env")
MIN_WORDS = 4          # shorter prompts are commands/ack noise, not questions
TIMEOUT_S = 3

DEFAULT_ROUTER = "http://10.0.0.249:8091"
LOOPBACK = {"127.0.0.1", "localhost", "::1"}


def read_token() -> str:
    """The router credential.

    Under a test override the protected store is not read at all: the value
    must be injected. Production reads the store, as before.
    """
    if os.environ.get("MEMORY_ROUTER_URL"):
        return os.environ.get("MEMORY_ROUTER_TEST_TOKEN", "")
    token = ""
    try:
        with open(SECRETS, encoding="utf-8") as fh:
            for line in fh:
                match = re.match(r"^MEMORY_ROUTER_TOKEN=(['\"]?)(.*)\1\s*$", line)
                if match:
                    token = match.group(2).rstrip()  # last-match-wins convention
    except Exception:
        pass
    return token


def router_base() -> str:
    """The router's address. Pinned, like kanban-post's.

    MEMORY_ROUTER_URL used to be honoured verbatim with no scheme or host
    check, so one environment variable sent the bearer token anywhere. It is
    now a loopback-only test hook. Returning "" means "refuse", and every
    refusal here is silent: this runs on the prompt path and must never
    break a turn.
    """
    override = os.environ.get("MEMORY_ROUTER_URL")
    if not override:
        return DEFAULT_ROUTER
    parts = urllib.parse.urlsplit(override)
    if (parts.hostname or "") in LOOPBACK:
        return override.rstrip("/")
    return ""


class RedirectRefused(Exception):
    """Raised instead of following a 3xx. See NoRedirects."""


class NoRedirects(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect. Following one would re-send the Authorization
    header to whatever host the response named, and the default router is
    PLAINTEXT http, so any hop can name one.

    Deliberate difference from the sibling brokers (bin/kanban-post,
    configs/cloudflare/cloudflare-render), which die() loudly here: this runs
    on the agent prompt path and must print nothing and exit 0 on ANY
    failure. So it raises, and main()'s broad except swallows it silently.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise RedirectRefused(f"refusing to follow a {code} redirect")


def scrub(text: str, secret: str) -> str:
    """Last line of defence before anything is printed.

    memory-hint's stdout is injected straight into agent context, so a router
    that echoes request headers back -- an error page, a proxy, a validation
    message quoting the request -- would otherwise put the bearer token into
    the transcript. Everything printed goes through here.
    """
    return text.replace(secret, "<redacted>") if secret else text


def main() -> int:
    class SilentArgumentParser(argparse.ArgumentParser):
        """ArgumentParser that exits silently on error."""
        def error(self, message: str) -> None:
            sys.exit(0)  # silently degrade to exit 0, never print error

    parser = SilentArgumentParser()
    parser.add_argument("--client", default="hook:unknown")
    parser.add_argument("--k", type=int, default=3)
    try:
        args = parser.parse_args()
    except SystemExit:  # argparse exits on error; degrade to silent 0
        return 0

    prompt = sys.stdin.read().strip()
    if not prompt or prompt.startswith("/") or len(prompt.split()) < MIN_WORDS:
        return 0
    token = read_token()
    if not token:
        return 0
    base = router_base()
    if not base:
        return 0
    request = urllib.request.Request(
        base + "/hint",
        data=json.dumps({"query": prompt, "k": args.k, "client": args.client}).encode(),
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
    )
    opener = urllib.request.build_opener(NoRedirects)
    try:
        with opener.open(request, timeout=TIMEOUT_S) as response:
            data = json.load(response)
        results = data.get("results") or []
        if not results:
            return 0
        lines = [
            '<memory-hints source="memory-lanes">',
            "Possibly relevant stored memories (leads, not facts - verify before relying on them):",
        ]
        for index, hit in enumerate(results, 1):
            lines.append(f"[{index}] {hit.get('citation', '?')}")
            lines.append(hit.get("text", "").strip())
        lines.append(
            f"(If a hint was decisive or wrong, report it: memory_feedback query_id={data.get('query_id', '')})"
        )
        lines.append("</memory-hints>")
        print(scrub("\n".join(lines), token))
    # Any failure, a refused redirect included: stay silent, never block the
    # agent. RedirectRefused is an Exception subclass, so it lands here.
    except Exception:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
